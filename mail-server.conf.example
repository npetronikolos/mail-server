# -----------------------------------------------------------------------------
# Mail server configuration
#
# Copy this file to "mail-server.conf" (next to install.sh), fill it in,
# then run:  sudo ./install.sh
#
# After installation a copy lives at /etc/mail-server/mail-server.conf and is
# used by the "mailctl" management command.
# -----------------------------------------------------------------------------

# Your main email domain (the part after the @).
DOMAIN="example.com"

# The server's own name. Must have an A record pointing at this server and a
# matching reverse DNS (PTR) record set at your hosting provider.
MAIL_HOSTNAME="mail.example.com"

# The server's public IPv4 address.
SERVER_IPV4="203.0.113.10"

# The server's public IPv6 address. Leave empty to send and receive mail over
# IPv4 only (recommended unless you have also set an IPv6 PTR record).
SERVER_IPV6=""

# First mailbox to create. Also receives mail for postmaster@, abuse@
# (including DMARC reports) and root's system mail. Must be an address at DOMAIN.
ADMIN_EMAIL="admin@example.com"

# Password for ADMIN_EMAIL. Leave empty to be asked during installation
# (or to have one generated when running without a terminal).
ADMIN_PASSWORD=""

# Email address Let's Encrypt uses for expiry warnings. Use an address that
# is NOT hosted on this server (e.g. a Gmail address), so you still get the
# warning if this server is down.
LETSENCRYPT_EMAIL="you@gmail.com"

# TLS certificates:
#   letsencrypt - free trusted certificate, renewed automatically (normal use)
#   selfsigned  - for lab/testing only; mail clients will show warnings
CERT_MODE="letsencrypt"

# Virus scanning with ClamAV. Needs about 1.5 GB of extra RAM; turn off on
# servers with less than 3 GB of memory.
ENABLE_CLAMAV="yes"

# Roundcube webmail at https://MAIL_HOSTNAME/
ENABLE_WEBMAIL="yes"

# Admin dashboard at https://MAIL_HOSTNAME/admin/ (sign in with an admin
# mailbox; ADMIN_EMAIL is the first admin). Everyone else who signs in gets a
# personal page: change password, 2FA, device setup.
ENABLE_DASHBOARD="yes"

# Only allow the dashboard from these IP addresses or networks (space
# separated, e.g. "203.0.113.7 198.51.100.0/24"). Empty = from anywhere
# (sign-in still required; turn on two-factor sign-in).
ADMIN_ALLOWED_IPS=""

# Calendars and contacts (CalDAV/CardDAV) at https://MAIL_HOSTNAME/dav/,
# signed in with the email address and password. Needs the dashboard.
ENABLE_DAV="yes"

# MTA-STS tells other mail servers (Gmail, Outlook...) to only ever send to
# you over an encrypted connection. Modes: enforce, testing, none.
ENABLE_MTA_STS="yes"
MTA_STS_MODE="enforce"

# DANE for outgoing mail: when a receiving domain publishes TLSA records in
# signed DNS, mail to it only goes out over encryption verified against them.
# This makes the local Unbound resolver (which checks DNSSEC) the whole
# server's DNS resolver. Set to "no" if this server must use your hosting
# provider's resolver (e.g. for private DNS names).
ENABLE_DANE="yes"

# Storage limit for new mailboxes, e.g. "5G" or "500M". Empty = unlimited.
# Change it per mailbox later with the dashboard or "mailctl user quota".
DEFAULT_QUOTA=""

# ---- Outgoing mail through a relay service (optional) ----
# Use this if your hosting provider blocks outgoing port 25, or to send
# through a service with an established reputation. Examples:
#   Brevo:      smtp-relay.brevo.com          RELAY_SPF="include:spf.brevo.com"
#   Mailgun:    smtp.mailgun.org              RELAY_SPF="include:mailgun.org"
#   Amazon SES: email-smtp.<region>.amazonaws.com  RELAY_SPF="include:amazonses.com"
# Leave RELAY_HOST empty to deliver directly. Can be changed later in the
# dashboard (Delivery page).
RELAY_HOST=""
RELAY_PORT="587"
RELAY_USER=""
RELAY_PASSWORD=""
RELAY_SPF=""

# How many messages each user may send per hour. Stops a stolen account from
# sending mass spam and getting your server blocklisted. 0 = no limit.
OUTGOING_LIMIT_PER_HOUR="200"

# Where problem alerts and the weekly report go. Empty = LETSENCRYPT_EMAIL
# (an address outside this server is best, so you hear about outages).
ALERT_EMAIL=""
WEEKLY_REPORT="yes"

# Create the DNS records automatically through your DNS provider's API.
# Supported: cloudflare, digitalocean. The token needs permission to edit DNS
# for your domain (Cloudflare: "Edit zone DNS" template). Empty = do it by hand.
# The A record for MAIL_HOSTNAME must still exist before installing.
DNS_PROVIDER=""
DNS_API_TOKEN=""

# Configure the UFW firewall (opens SSH + mail + web ports, blocks the rest).
ENABLE_FIREWALL="yes"

# Your SSH port, so the firewall does not lock you out.
SSH_PORT="22"

# DKIM selector name (appears in DNS as <selector>._domainkey.DOMAIN).
DKIM_SELECTOR="mail"

# Largest email (including attachments) that can be sent or received, in MB.
MESSAGE_SIZE_LIMIT_MB="50"

# Server time zone (e.g. "Europe/Athens", "America/New_York").
TIMEZONE="UTC"

# Nightly backups.
BACKUP_DIR="/var/backups/mail-server"
BACKUP_KEEP_DAYS="14"

# Also copy every backup to another machine over SSH, e.g.
# "backup@nas.example.com:/backups/mail". root's SSH key must be allowed to
# log in there (ssh-keygen, then ssh-copy-id). Empty = keep backups local.
BACKUP_RSYNC_TARGET=""
