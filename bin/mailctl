#!/usr/bin/env bash
# mailctl - manage the mail server installed by install.sh
#
# Run "mailctl help" for usage.
set -euo pipefail

CONF=/etc/mail-server/mail-server.conf
USERS_FILE=/etc/dovecot/users
VDOMAINS=/etc/postfix/vdomains
VMAILBOX=/etc/postfix/vmailbox
VALIASES=/etc/postfix/virtual
SENDER_LOGIN=/etc/postfix/sender_login
DKIM_DIR=/var/lib/rspamd/dkim
VMAIL_DIR=/var/vmail
LOCK_FILE=/run/mailctl.lock

die()  { echo "mailctl: $*" >&2; exit 1; }
info() { echo "==> $*"; }

[[ $EUID -eq 0 ]] || die "must be run as root (use sudo)"
[[ -r $CONF ]] || die "$CONF not found - run install.sh first"
# shellcheck source=/dev/null
source "$CONF"
DKIM_SELECTOR=${DKIM_SELECTOR:-mail}

# Serialise all changes so two mailctl runs never clobber each other's edits.
exec 9>"$LOCK_FILE"
flock 9

usage() {
  cat <<EOF
Usage: mailctl <command> [arguments]

Mailboxes
  user add <email>              Create a mailbox (asks for the password)
  user passwd <email>           Change a mailbox password
  user del <email> [--purge]    Remove a mailbox (--purge also deletes its mail)
  user list                     List mailboxes and their disk usage

Aliases / forwarding
  alias add <alias> <dest>[,<dest>...]
                                Forward <alias> to one or more addresses.
                                Use @domain as <alias> for a catch-all.
  alias del <alias>             Remove an alias
  alias list                    List aliases

Domains
  domain add <domain>           Host mail for another domain (creates its DKIM key)
  domain del <domain>           Stop hosting a domain (must have no mailboxes)
  domain list                   List hosted domains

Other
  dns [domain]                  Print the DNS records to create
  status                        Show service, certificate and queue status
  backup                        Run a backup now

Passwords can be piped in for scripting: echo 'secret' | mailctl user add a@b.com
EOF
}

# ---------------------------------------------------------------- helpers

lower() { tr '[:upper:]' '[:lower:]' <<<"$1"; }

valid_email() {
  [[ $1 =~ ^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$ ]]
}

valid_domain() {
  [[ $1 =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]]
}

domain_of() { echo "${1#*@}"; }

# key_in_file <key> <file>: true if the first column of a line equals key.
key_in_file() {
  [[ -f $2 ]] && awk -v k="$1" '$1 == k { found = 1 } END { exit !found }' "$2"
}

# remove_key <key> <file>: delete lines whose first column equals key.
remove_key() {
  local tmp
  tmp=$(mktemp "$2.XXXXXX")
  awk -v k="$1" '$1 != k' "$2" >"$tmp"
  chmod --reference="$2" "$tmp"
  chown --reference="$2" "$tmp"
  mv "$tmp" "$2"
}

# commit_users_file <tmp>: atomically replace the Dovecot users file.
# Dovecot re-reads the file when its size or modification time (in whole
# seconds) changes. A password change keeps the size, so make sure the
# modification time always moves forward, even for two edits in one second.
commit_users_file() {
  local tmp=$1 old
  old=$(stat -c %Y "$USERS_FILE")
  chmod --reference="$USERS_FILE" "$tmp"
  chown --reference="$USERS_FILE" "$tmp"
  mv "$tmp" "$USERS_FILE"
  if (( $(stat -c %Y "$USERS_FILE") <= old )); then
    touch -d "@$((old + 1))" "$USERS_FILE"
  fi
}

user_exists() {
  [[ -f $USERS_FILE ]] && awk -F: -v k="$1" '$1 == k { found = 1 } END { exit !found }' "$USERS_FILE"
}

domain_exists() { key_in_file "$1" "$VDOMAINS"; }

read_password() {
  local pw pw2
  if [[ -t 0 ]]; then
    read -rsp "Password for $1: " pw; echo >&2
    read -rsp "Repeat password: " pw2; echo >&2
    [[ $pw == "$pw2" ]] || die "passwords do not match"
  else
    IFS= read -r pw || true
  fi
  [[ ${#pw} -ge 10 ]] || die "password must be at least 10 characters"
  [[ $pw != *:* ]] || die "password must not contain ':'"
  printf '%s' "$pw"
}

hash_password() {
  # SHA512-CRYPT; the password is passed on stdin so it never shows in ps.
  printf '%s\n' "$1" | openssl passwd -6 -stdin | sed 's/^/{SHA512-CRYPT}/'
}

# Rebuild the map that says which login may use which From: address.
# A user may send as their own address and as any alias that delivers to them.
rebuild_sender_login() {
  local tmp
  tmp=$(mktemp "$SENDER_LOGIN.XXXXXX")
  {
    awk '{ print $1, $1 }' "$VMAILBOX"
    awk '{ print $1, $2 }' "$VALIASES"
  } | awk '
      {
        k = $1
        if (k in owners) owners[k] = owners[k] "," $2
        else owners[k] = $2
      }
      END { for (a in owners) print a, owners[a] }' | sort >"$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$SENDER_LOGIN"
}

postmap_all() {
  rebuild_sender_login
  local f
  for f in "$VDOMAINS" "$VMAILBOX" "$VALIASES" "$SENDER_LOGIN"; do
    postmap "hash:$f"
  done
}

# ---------------------------------------------------------------- users

user_add() {
  local email pw
  email=$(lower "${1:-}")
  valid_email "$email" || die "invalid email address: ${1:-<none>}"
  domain_exists "$(domain_of "$email")" || die "domain $(domain_of "$email") is not hosted here (mailctl domain add ...)"
  user_exists "$email" && die "$email already exists"
  key_in_file "$email" "$VALIASES" && die "$email is already an alias"

  pw=$(read_password "$email")
  local tmp
  tmp=$(mktemp "$USERS_FILE.XXXXXX")
  cat "$USERS_FILE" >"$tmp"
  echo "$email:$(hash_password "$pw")::::::" >>"$tmp"
  commit_users_file "$tmp"
  echo "$email OK" >>"$VMAILBOX"
  postmap_all

  # Create the mailbox right away so the default folders exist.
  doveadm mailbox list -u "$email" >/dev/null 2>&1 || true
  info "created mailbox $email"
}

user_passwd() {
  local email pw hash tmp
  email=$(lower "${1:-}")
  user_exists "$email" || die "no such mailbox: ${1:-<none>}"
  pw=$(read_password "$email")
  hash=$(hash_password "$pw")
  tmp=$(mktemp "$USERS_FILE.XXXXXX")
  awk -F: -v OFS=: -v k="$email" -v h="$hash" '$1 == k { $2 = h } { print }' "$USERS_FILE" >"$tmp"
  commit_users_file "$tmp"
  info "password changed for $email"
}

user_del() {
  local email purge=no tmp
  email=$(lower "${1:-}")
  [[ ${2:-} == --purge ]] && purge=yes
  user_exists "$email" || die "no such mailbox: ${1:-<none>}"

  tmp=$(mktemp "$USERS_FILE.XXXXXX")
  awk -F: -v k="$email" '$1 != k' "$USERS_FILE" >"$tmp"
  commit_users_file "$tmp"
  remove_key "$email" "$VMAILBOX"
  postmap_all
  doveadm auth cache flush >/dev/null 2>&1 || true
  doveadm kick "$email" >/dev/null 2>&1 || true

  local dir
  dir="$VMAIL_DIR/$(domain_of "$email")/${email%@*}"
  if [[ $purge == yes ]]; then
    rm -rf -- "$dir"
    info "removed mailbox $email and deleted its mail"
  else
    info "removed mailbox $email (mail kept in $dir; use --purge to delete)"
  fi
}

user_list() {
  [[ -s $USERS_FILE ]] || { echo "(no mailboxes)"; return; }
  printf '%-45s %s\n' "MAILBOX" "SIZE"
  local email dir size
  while IFS=: read -r email _; do
    [[ -n $email ]] || continue
    dir="$VMAIL_DIR/$(domain_of "$email")/${email%@*}"
    size=$(du -sh "$dir" 2>/dev/null | cut -f1)
    printf '%-45s %s\n' "$email" "${size:-0}"
  done <"$USERS_FILE"
}

# ---------------------------------------------------------------- aliases

alias_add() {
  local alias dests d
  alias=$(lower "${1:-}")
  dests=$(lower "${2:-}")
  dests=${dests// /}
  [[ -n $alias && -n $dests ]] || die "usage: mailctl alias add <alias> <dest>[,<dest>...]"

  if [[ $alias == @* ]]; then
    valid_domain "${alias#@}" || die "invalid catch-all: $alias"
  else
    valid_email "$alias" || die "invalid alias address: $alias"
  fi
  domain_exists "$(domain_of "$alias")" || die "domain $(domain_of "$alias") is not hosted here"
  user_exists "$alias" && die "$alias is a mailbox; delete it first or pick another address"
  key_in_file "$alias" "$VALIASES" && die "alias $alias already exists (delete it first to change it)"

  IFS=, read -ra list <<<"$dests"
  for d in "${list[@]}"; do
    valid_email "$d" || die "invalid destination address: $d"
  done

  echo "$alias $dests" >>"$VALIASES"
  postmap_all
  info "alias $alias -> $dests"
}

alias_del() {
  local alias
  alias=$(lower "${1:-}")
  key_in_file "$alias" "$VALIASES" || die "no such alias: ${1:-<none>}"
  remove_key "$alias" "$VALIASES"
  postmap_all
  info "removed alias $alias"
}

alias_list() {
  [[ -s $VALIASES ]] || { echo "(no aliases)"; return; }
  awk '{ printf "%-40s -> %s\n", $1, $2 }' "$VALIASES"
}

# ---------------------------------------------------------------- domains

domain_add() {
  local domain key
  domain=$(lower "${1:-}")
  valid_domain "$domain" || die "invalid domain: ${1:-<none>}"
  domain_exists "$domain" && die "$domain is already hosted here"

  key="$DKIM_DIR/$domain.$DKIM_SELECTOR.key"
  install -d -o _rspamd -g _rspamd -m 750 "$DKIM_DIR"
  if [[ ! -f $key ]]; then
    rspamadm dkim_keygen -b 2048 -s "$DKIM_SELECTOR" -d "$domain" -k "$key" >/dev/null
    chown _rspamd:_rspamd "$key"
    chmod 640 "$key"
  fi

  echo "$domain OK" >>"$VDOMAINS"
  install -d -o vmail -g vmail -m 750 "$VMAIL_DIR/$domain"
  # Rspamd reads the key file when it signs, so no reload is needed.
  postmap_all

  # Standard role addresses (RFC 2142) go to the administrator.
  local role
  for role in postmaster abuse; do
    if ! user_exists "$role@$domain" && ! key_in_file "$role@$domain" "$VALIASES"; then
      echo "$role@$domain $ADMIN_EMAIL" >>"$VALIASES"
    fi
  done
  postmap_all

  info "now hosting $domain"
  echo
  dns_records "$domain"
}

domain_del() {
  local domain
  domain=$(lower "${1:-}")
  domain_exists "$domain" || die "no such domain: ${1:-<none>}"
  [[ $domain == "$DOMAIN" ]] && die "refusing to remove the primary domain $DOMAIN"
  if awk -F: -v d="@$domain" 'substr($1, length($1) - length(d) + 1) == d { f = 1 } END { exit !f }' "$USERS_FILE"; then
    die "$domain still has mailboxes; delete them first (mailctl user list)"
  fi

  remove_key "$domain" "$VDOMAINS"
  local tmp
  tmp=$(mktemp "$VALIASES.XXXXXX")
  awk -v d="@$domain" 'substr($1, length($1) - length(d) + 1) != d' "$VALIASES" >"$tmp"
  chmod 644 "$tmp"
  mv "$tmp" "$VALIASES"
  postmap_all
  info "stopped hosting $domain (DKIM key kept in $DKIM_DIR)"
}

domain_list() {
  [[ -s $VDOMAINS ]] || { echo "(no domains)"; return; }
  awk '{ print $1 }' "$VDOMAINS"
}

# ---------------------------------------------------------------- DNS

dns_records() {
  local domain=${1:-$DOMAIN} key pub
  domain=$(lower "$domain")
  domain_exists "$domain" || die "$domain is not hosted here"
  key="$DKIM_DIR/$domain.$DKIM_SELECTOR.key"
  [[ -f $key ]] || die "no DKIM key for $domain ($key)"
  pub=$(openssl pkey -in "$key" -pubout -outform DER 2>/dev/null | base64 -w0)

  cat <<EOF
DNS records for $domain
(create these at your DNS provider; "@" means the domain itself)

TYPE  NAME                               VALUE
EOF
  if [[ $domain == "$DOMAIN" ]]; then
    printf '%-5s %-34s %s\n' A "$MAIL_HOSTNAME." "$SERVER_IPV4"
    [[ -n ${SERVER_IPV6:-} ]] && printf '%-5s %-34s %s\n' AAAA "$MAIL_HOSTNAME." "$SERVER_IPV6"
  fi
  printf '%-5s %-34s %s\n' MX "@" "10 $MAIL_HOSTNAME."
  printf '%-5s %-34s %s\n' TXT "@" "\"v=spf1 mx -all\""
  printf '%-5s %-34s %s\n' TXT "$DKIM_SELECTOR._domainkey" "\"v=DKIM1; k=rsa; p=$pub\""
  printf '%-5s %-34s %s\n' TXT "_dmarc" "\"v=DMARC1; p=quarantine; rua=mailto:postmaster@$domain; adkim=r; aspf=r\""
  printf '%-5s %-34s %s\n' SRV "_imaps._tcp" "0 1 993 $MAIL_HOSTNAME."
  printf '%-5s %-34s %s\n' SRV "_submissions._tcp" "0 1 465 $MAIL_HOSTNAME."
  printf '%-5s %-34s %s\n' SRV "_submission._tcp" "0 1 587 $MAIL_HOSTNAME."
  printf '%-5s %-34s %s\n' CNAME "autoconfig" "$MAIL_HOSTNAME."
  echo
  if [[ $domain == "$DOMAIN" ]]; then
    echo "Reverse DNS (set in your hosting provider's control panel, not at your DNS provider):"
    echo "  PTR  $SERVER_IPV4  ->  $MAIL_HOSTNAME"
    [[ -n ${SERVER_IPV6:-} ]] && echo "  PTR  $SERVER_IPV6  ->  $MAIL_HOSTNAME"
    echo
  fi
  echo "The DKIM value is long. If your DNS provider rejects it, split it into"
  echo "several quoted strings of up to 255 characters; most providers do this for you."
}

# ---------------------------------------------------------------- status

status() {
  local svc state
  echo "Services"
  for svc in postfix dovecot rspamd redis-server unbound nginx fail2ban \
             clamav-daemon clamav-freshclam; do
    systemctl cat "$svc.service" >/dev/null 2>&1 || continue
    state=$(systemctl is-active "$svc" 2>/dev/null || true)
    printf '  %-18s %s\n' "$svc" "$state"
  done
  local fpm
  fpm=$(systemctl list-units --type=service --all --no-legend 'php*-fpm.service' 2>/dev/null | awk 'NR == 1 { print $1 }')
  [[ -n $fpm ]] && printf '  %-18s %s\n' "${fpm%.service}" "$(systemctl is-active "$fpm" || true)"

  echo
  echo "Certificate"
  local cert
  cert=$(postconf -h smtpd_tls_chain_files 2>/dev/null | awk -F', *' '{ print $2 }')
  if [[ -n $cert && -r $cert ]]; then
    echo "  $(openssl x509 -in "$cert" -noout -subject | sed 's/subject=//')"
    echo "  expires $(openssl x509 -in "$cert" -noout -enddate | cut -d= -f2)"
  else
    echo "  not found"
  fi

  echo
  echo "Mail"
  echo "  domains:   $(grep -c . "$VDOMAINS" 2>/dev/null || echo 0)"
  echo "  mailboxes: $(grep -c . "$USERS_FILE" 2>/dev/null || echo 0)"
  echo "  aliases:   $(grep -c . "$VALIASES" 2>/dev/null || echo 0)"
  echo "  queue:     $(postqueue -j 2>/dev/null | grep -c . || true) message(s) waiting"
  echo "  disk:      $(du -sh "$VMAIL_DIR" 2>/dev/null | cut -f1) in $VMAIL_DIR"
}

# ---------------------------------------------------------------- main

cmd=${1:-help}
sub=${2:-}
case "$cmd" in
  user)
    case "$sub" in
      add)    user_add "${3:-}" ;;
      passwd) user_passwd "${3:-}" ;;
      del)    user_del "${3:-}" "${4:-}" ;;
      list)   user_list ;;
      *)      usage; exit 1 ;;
    esac ;;
  alias)
    case "$sub" in
      add)  alias_add "${3:-}" "${4:-}" ;;
      del)  alias_del "${3:-}" ;;
      list) alias_list ;;
      *)    usage; exit 1 ;;
    esac ;;
  domain)
    case "$sub" in
      add)  domain_add "${3:-}" ;;
      del)  domain_del "${3:-}" ;;
      list) domain_list ;;
      *)    usage; exit 1 ;;
    esac ;;
  dns)    dns_records "${2:-$DOMAIN}" ;;
  status) status ;;
  backup) flock -u 9; exec /usr/local/sbin/mail-backup ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
