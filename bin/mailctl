Add --json to any command for machine-readable output.
Passwords can be piped in for scripting: echo 'secret' | mailctl user add a@b.com"""


def emit(data, human=None):
    if JSON:
        print(json.dumps(data, default=str))
    elif human:
        human(data)


def main(argv):
    global JSON, ACTOR, C
    args = list(argv)
    if "--json" in args:
        JSON = True
        args.remove("--json")
    if "--actor" in args:
        i = args.index("--actor")
        ACTOR = args[i + 1] if i + 1 < len(args) else None
        del args[i:i + 2]

    def opt(name, default=None):
        if name in args:
            i = args.index(name)
            val = args[i + 1] if i + 1 < len(args) else None
            del args[i:i + 2]
            return val
        return default

    def flag(name):
        if name in args:
            args.remove(name)
            return True
        return False

    if not args or args[0] in ("help", "-h", "--help"):
        print(USAGE)
        return 0
    if os.geteuid() != 0:
        raise Fail("must be run as root (use sudo)")
    C = load_conf()

    # Python file descriptors are not inherited by child processes, so the
    # lock is never held by a service that mailctl happens to (re)start.
    # Password checks only read, and sign-ins must not wait behind a long job.
    lock = open(LOCK_FILE, "w")
    if args[:2] != ["user", "checkpw"]:
        fcntl.flock(lock, fcntl.LOCK_EX)

    cmd = args[0]
    sub = args[1] if len(args) > 1 else ""
    a = args[2:]
    arg = a[0] if a else ""

    if cmd == "user":
        if sub == "add":
            quota = opt("--quota")
            a = args[2:]
            emit(user_add(a[0] if a else "", quota))
        elif sub == "passwd":
            emit(user_passwd(arg))
        elif sub == "quota":
            if len(a) < 2:
                raise Fail("usage: mailctl user quota <email> <size|none>")
            emit(user_quota(a[0], a[1]))
        elif sub == "del":
            purge = flag("--purge")
            a = args[2:]
            emit(user_del(a[0] if a else "", purge))
        elif sub == "list":
            emit(user_list(), lambda d: table(
                [(u["email"], human_bytes(u["used_bytes"]), u["quota"] or "unlimited",
                  "-" if u["messages"] is None else u["messages"],
                  "admin" if u["admin"] else "") for u in d],
                ["mailbox", "used", "quota", "messages", ""]))
        elif sub == "info":
            emit(user_info(arg), lambda u: print(json.dumps(u, indent=2)))
        elif sub == "forward":
            off = flag("--off")
            keep = not flag("--no-keep")
            to = opt("--to", "")
            a = args[2:]
            emit(user_forward(a[0] if a else "", to, keep, off), show_rules)
        elif sub == "vacation":
            off = flag("--off")
            subject, start, end = opt("--subject", ""), opt("--start", ""), opt("--end", "")
            a = args[2:]
            emit(user_vacation(a[0] if a else "", subject, start, end, off), show_rules)
        elif sub == "rules":
            emit(rules_get(arg), show_rules)
        elif sub == "checkpw":
            apps = flag("--app")
            a = args[2:]
            emit(user_checkpw(a[0] if a else "", apps), lambda r: print("ok" if r["ok"] else "wrong"))
        elif sub == "apppass":
            act = a[0] if a else ""
            name = opt("--name", "")
            rest = args[3:]
            email = rest[0] if rest else ""
            if act == "add":
                emit(apppw_add(email, name), lambda r: print(
                    f"App password for {r['email']} ({r['name']}):\n\n    {r['password']}\n\n"
                    "Use it instead of the mailbox password in that app. It is not shown again."))
            elif act == "del":
                emit(apppw_del(email, rest[1] if len(rest) > 1 else ""), show_apppw)
            elif act == "require":
                emit(apppw_require(email, rest[1] if len(rest) > 1 else ""), show_apppw)
            elif act == "list":
                emit(apppw_list(email), show_apppw)
            else:
                print(USAGE)
                return 1
        elif sub == "import":
            act = a[0] if a else ""
            host, port, security = opt("--host"), opt("--port"), opt("--security", "ssl")
            iuser, private = opt("--user", ""), flag("--allow-private")
            rest = args[3:]
            email = rest[0] if rest else ""
            if act == "start":
                emit(import_start(email, host, port, security, iuser, private), show_import)
            elif act == "run":
                fcntl.flock(lock, fcntl.LOCK_UN)     # takes hours; let everything else go on
                emit(import_run(email), show_import)
            elif act == "cancel":
                emit(import_cancel(email), show_import)
            elif act == "status":
                emit(import_status(email), show_import)
            else:
                print(USAGE)
                return 1
        else:
            print(USAGE)
            return 1
    elif cmd == "alias":
        if sub == "add":
            emit(alias_add(arg, a[1] if len(a) > 1 else ""))
        elif sub == "del":
            emit(alias_del(arg))
        elif sub == "list":
            emit(alias_list(), lambda d: table(
                [(x["alias"], "-> " + ",".join(x["destinations"])) for x in d],
                ["alias", "destinations"]))
        elif sub == "temp":
            act = a[0] if a else "list"
            owner, days, note = opt("--owner"), opt("--days"), opt("--note", "")
            rest = args[3:]
            if act == "add":
                emit(temp_add(rest[0] if rest else owner, days, note),
                     lambda t: print(t["alias"]))
            elif act == "del":
                emit(temp_del(rest[0] if rest else "", owner))
            elif act == "expire":
                emit(temp_expire(), lambda d: print(f"expired: {len(d['expired'])}"))
            else:
                emit(temp_list(owner), lambda d: table(
                    [(t["alias"], t["owner"], (t["expires"] or "never")[:10], t["note"]) for t in d],
                    ["address", "delivers to", "expires", "note"]))
        else:
            print(USAGE)
            return 1
    elif cmd == "domain":
        if sub == "add":
            emit(domain_add(arg), lambda d: (print(), print_dns(d["domain"], d["records"])))
        elif sub == "del":
            emit(domain_del(arg))
        elif sub == "list":
            emit(domain_list(), lambda d: table(
                [(x["domain"], x["mailboxes"], x["aliases"], "primary" if x["primary"] else "")
                 for x in d], ["domain", "mailboxes", "aliases", ""]))
        else:
            print(USAGE)
            return 1
    elif cmd == "dns" and sub == "provider":
        act = a[0] if a else "status"
        if act == "set":
            emit(dns_provider_set(a[1] if len(a) > 1 else ""))
        elif act == "off":
            emit(dns_provider_set(None, off=True))
        else:
            emit(dns_provider_status(), lambda d: print(
                f"{d['name']} (connected)" if d["connected"] else "no DNS provider connected"))
    elif cmd == "dns" and sub == "apply":
        yes = flag("--yes")
        a = args[2:]
        res = dns_apply(a[0] if a else None, dry_run=not yes)

        def show_plan(r):
            print(f"{r['provider']} zone {r['zone']}" + ("  (preview - add --yes to apply)" if r["dry_run"] else ""))
            table([(p["action"], p["type"], p["fqdn"], (p["value"][:60] + "...") if len(p["value"]) > 63 else p["value"])
                   for p in r["plan"]], ["action", "type", "name", "value"])
        emit(res, show_plan)
    elif cmd == "dns":
        check = flag("--check")
        dom = (args[1] if len(args) > 1 else C["DOMAIN"]).lower()
        if check:
            emit(dns_check(dom), lambda d: table(
                [(MARK[r["status"]], r["type"], r["name"], r["note"] or "ok") for r in d],
                ["", "type", "name", "result"]))
        else:
            emit(dns_records(dom), lambda d: print_dns(dom, d))
    elif cmd == "status":
        emit(status(), show_status)
    elif cmd == "check":
        emit(checks(include_dns=not flag("--no-dns")), show_checks)
    elif cmd == "queue":
        if sub in ("", "list"):
            emit(queue_list(), lambda d: table(
                [(q["id"], q["queue"], q["arrival"][:16], q["sender"] or "<>",
                  ",".join(r["address"] for r in q["recipients"]),
                  q["recipients"][0]["reason"][:60] if q["recipients"] else "") for q in d],
                ["id", "queue", "arrived", "from", "to", "reason"]))
        else:
            emit(queue_action(sub, arg or None))
    elif cmd == "bans":
        emit(bans(), lambda d: table(
            [(b["jail"], b["total_failed"], " ".join(b["banned"]) or "-") for b in d],
            ["jail", "failed", "banned ips"]))
    elif cmd == "unban":
        emit(unban(sub))
    elif cmd == "logs":
        lines = opt("--lines", 200)
        grep = opt("--grep")
        kind = args[1] if len(args) > 1 else "mail"
        emit(logs(kind, lines, grep), lambda d: print("\n".join(d)))
    elif cmd == "backup":
        if sub == "list":
            emit(backup_list(), lambda d: table(
                [(b["file"], human_bytes(b["size"]), b["created"][:16].replace("T", " ")) for b in d],
                ["file", "size", "created"]))
        elif sub in ("", "run", "--background"):
            bg = sub == "--background" or flag("--background")
            fcntl.flock(lock, fcntl.LOCK_UN)
            emit(backup_run(bg))
        else:
            print(USAGE)
            return 1
    elif cmd == "admin":
        if sub == "add":
            emit(admin_add(arg))
        elif sub == "del":
            emit(admin_del(arg))
        elif sub == "list":
            emit(read_admins(), lambda d: print("\n".join(d) or "(none)"))
        else:
            print(USAGE)
            return 1
    elif cmd == "relay":
        if sub == "set":
            port, user, spf = opt("--port", 587), opt("--user", ""), opt("--spf", "")
            a = args[2:]
            emit(relay_set(a[0] if a else "", port, user, spf))
        elif sub == "off":
            emit(relay_off())
        elif sub == "test":
            emit(relay_test())
        else:
            emit(relay_status(), lambda r: print(
                f"relay: {r['host']}:{r['port']} (user {r['user'] or '-'})" if r["enabled"] else "relay: off (direct delivery)"))
    elif cmd == "limit":
        if sub == "set":
            emit(limit_set(arg))
        else:
            emit(limit_status(), lambda r: print(
                f"{r['per_hour']} messages per user per hour" if r["per_hour"] else "no outgoing limit"))
    elif cmd == "share":
        if sub == "add":
            emit(share_add(arg, a[1] if len(a) > 1 else ""))
        elif sub == "del":
            emit(share_del(arg, a[1] if len(a) > 1 else ""))
        elif sub == "sync":
            emit(share_sync(), lambda d: print("sharing re-applied"))
        else:
            emit(shares_load(), lambda d: table(
                [(k, ", ".join(v)) for k, v in d.items()], ["mailbox", "shared with"]))
    elif cmd == "junk":
        if sub in ("release", "delete"):
            emit(junk_action(sub, arg, a[1] if len(a) > 1 else ""))
        else:
            user, days = opt("--user"), opt("--days", 30)
            emit(junk_list(user, days), lambda d: table(
                [(j["date"][:16] if j["date"] else "", j["user"], j["from"][:30], j["subject"][:40], j["id"])
                 for j in d], ["date", "mailbox", "from", "subject", "id"]))
    elif cmd == "search":
        if sub == "rebuild":
            emit(search_rebuild(arg or None))
        else:
            print(USAGE)
            return 1
    elif cmd == "alerts":
        if sub == "run":
            emit(alerts_run())
        elif sub == "test":
            emit(alerts_test())
        elif sub == "config":
            email, weekly = opt("--email"), opt("--weekly")
            emit(alerts_config(email, weekly))
        else:
            emit(alerts_status(), lambda r: print(
                f"alerts go to {r['recipient']}; weekly report {'on' if r['weekly_report'] else 'off'}; "
                f"{len(r['open'])} open problem(s)"))
    elif cmd == "report":
        emit(report_weekly(force=flag("--force")))
    elif cmd == "dmarc":
        days = opt("--days", 30)

        def show_dmarc(r):
            if not r["domains"]:
                print("no DMARC reports yet")
            for d in r["domains"]:
                print(f"\n{d['domain']}: {d['reports']} reports, {d['messages']} messages, "
                      f"{d['failed']} failed ({d['foreign_failed']} from other servers)")
                table([(x["ip"], "this server" if x["own"] else "", x["messages"], x["passed"], x["failed"])
                       for x in d["sources"][:20]], ["source ip", "", "messages", "passed", "failed"])
        emit(dmarc_summary(days), show_dmarc)
    elif cmd == "cert":
        emit(cert_refresh())
    elif cmd == "migrate":
        emit(migrate())
    else:
        print(USAGE)
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        if JSON:
            print(json.dumps({"error": str(e)}))
        else:
            print(f"mailctl: {e}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
