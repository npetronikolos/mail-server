#!/usr/bin/env python3
"""mailctl - manage the mail server installed by install.sh.

Run "mailctl help" for usage. Add --json to any command for machine-readable
output (used by the admin dashboard).
"""
import base64
import datetime
import fcntl
import getpass
import glob
import hashlib
import hmac
import ipaddress
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import tempfile
import time

CONF = "/etc/mail-server/mail-server.conf"
USERS_FILE = "/etc/dovecot/users"
VDOMAINS = "/etc/postfix/vdomains"
VMAILBOX = "/etc/postfix/vmailbox"
VALIASES = "/etc/postfix/virtual"
SENDER_LOGIN = "/etc/postfix/sender_login"
ADMINS_FILE = "/etc/mail-server/admins"
AUDIT_LOG = "/var/log/mailctl.log"
DKIM_DIR = "/var/lib/rspamd/dkim"
VMAIL_DIR = "/var/vmail"
MTA_STS_FILE = "/var/www/mail-autoconfig/mta-sts.txt"
LOCK_FILE = "/run/mailctl.lock"
DMARC_ADDRESS = "reports@dmarc.invalid"   # routed to the DMARC report reader

EMAIL_RE = re.compile(r"^[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$")
DOMAIN_RE = re.compile(r"^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$")
QUOTA_RE = re.compile(r"^[0-9]+[KMGT]?$")
QUEUE_ID_RE = re.compile(r"^[0-9A-Za-z]{6,}$")

SERVICES = ["postfix", "dovecot", "rspamd", "redis-server", "unbound", "nginx",
            "fail2ban", "clamav-daemon", "clamav-freshclam",
            "postfix-mta-sts-resolver", "radicale", "mail-dashboard"]

JSON = False
ACTOR = None
C = {}


class Fail(Exception):
    pass


# ------------------------------------------------------------------ basics

def load_conf():
    conf = {}
    try:
        with open(CONF) as f:
            for line in f:
                m = re.match(r"^\s*([A-Z0-9_]+)=(.*)$", line)
                if not m:
                    continue
                v = m.group(2).strip()
                if v[:1] in "\"'":
                    end = v.find(v[0], 1)
                    v = v[1:end] if end > 0 else v[1:]
                else:
                    v = v.split("#", 1)[0].strip()
                conf[m.group(1)] = v
    except FileNotFoundError:
        raise Fail(f"{CONF} not found - run install.sh first")
    defaults = {"DKIM_SELECTOR": "mail", "SERVER_IPV6": "", "CERT_MODE": "letsencrypt",
                "ENABLE_MTA_STS": "yes", "ENABLE_DAV": "yes", "DEFAULT_QUOTA": "",
                "BACKUP_DIR": "/var/backups/mail-server"}
    for k, v in defaults.items():
        if not conf.get(k):
            conf[k] = v
    for k in ("DOMAIN", "MAIL_HOSTNAME", "ADMIN_EMAIL"):
        conf[k] = conf.get(k, "").lower()
    return conf


def run(cmd, input=None, check=True, timeout=120):
    try:
        p = subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        if check:
            raise Fail(f"command not found: {cmd[0]}")
        return subprocess.CompletedProcess(cmd, 127, "", "")
    except subprocess.TimeoutExpired:
        if check:
            raise Fail(f"timed out: {' '.join(cmd)}")
        return subprocess.CompletedProcess(cmd, 124, "", "timeout")
    if check and p.returncode != 0:
        raise Fail(f"{' '.join(cmd[:3])} failed: {(p.stderr or p.stdout).strip()}")
    return p


def info(msg):
    if not JSON:
        print(f"==> {msg}")


def audit(action):
    who = ACTOR or os.environ.get("SUDO_USER") or "root"
    stamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(AUDIT_LOG, "a") as f:
            f.write(f"{stamp}\t{who}\t{action}\n")
        os.chmod(AUDIT_LOG, 0o640)
    except OSError:
        pass


def lower_email(value, what="email address"):
    v = (value or "").strip().lower()
    if not EMAIL_RE.match(v):
        raise Fail(f"invalid {what}: {value or '<none>'}")
    return v


def lower_domain(value):
    v = (value or "").strip().lower()
    if not DOMAIN_RE.match(v):
        raise Fail(f"invalid domain: {value or '<none>'}")
    return v


def domain_of(email):
    return email.split("@", 1)[1]


def human_bytes(n):
    if n is None:
        return "-"
    n = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if n < 1024 or unit == "T":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return str(n)


def quota_to_bytes(q):
    if not q:
        return None
    mult = {"K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
    if q[-1] in mult:
        return int(q[:-1]) * mult[q[-1]]
    return int(q)


def normalize_quota(q):
    q = (q or "").strip().upper().replace(" ", "")
    if q in ("", "0", "NONE", "UNLIMITED"):
        return ""
    if len(q) > 2 and q.endswith("B") and q[-2] in "KMGT":
        q = q[:-1]
    if not QUOTA_RE.match(q):
        raise Fail(f"invalid quota '{q}': use a size like 500M, 2G or 'none'")
    return q


# ------------------------------------------------------------------ map files

def read_map(path):
    rows = []
    try:
        with open(path) as f:
            for line in f:
                parts = line.split()
                if parts:
                    rows.append((parts[0], parts[1] if len(parts) > 1 else ""))
    except FileNotFoundError:
        pass
    return rows


def write_file(path, text, mode=0o644, like=None):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=os.path.basename(path) + ".")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    if like and os.path.exists(like):
        st = os.stat(like)
        os.chmod(tmp, st.st_mode & 0o7777)
        os.chown(tmp, st.st_uid, st.st_gid)
    else:
        os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_map(path, rows):
    write_file(path, "".join(f"{k} {v}\n" for k, v in rows), like=path)


def map_keys(path):
    return {k for k, _ in read_map(path)}


def rebuild_sender_login():
    """Which login may use which From: address: own address + aliases to it."""
    owners = {}
    for k, _ in read_map(VMAILBOX):
        owners.setdefault(k, []).append(k)
    for k, v in read_map(VALIASES):
        owners.setdefault(k, []).extend(x for x in v.split(",") if x)
    for mailbox, members in read_json(SHARES_FILE, {}).items():
        owners.setdefault(mailbox, []).extend(members)
    rows = sorted((k, ",".join(dict.fromkeys(v))) for k, v in owners.items())
    write_file(SENDER_LOGIN, "".join(f"{k} {v}\n" for k, v in rows), mode=0o644)


def postmap_all():
    rebuild_sender_login()
    for f in (VDOMAINS, VMAILBOX, VALIASES, SENDER_LOGIN):
        run(["postmap", f"hash:{f}"])


# ------------------------------------------------------------------ users file

def dovecot_version():
    p = run(["dovecot", "--version"], check=False)
    m = re.match(r"(\d+)\.(\d+)", p.stdout or "")
    return (int(m.group(1)), int(m.group(2))) if m else (2, 3)


def quota_field(q):
    if not q:
        return ""
    if dovecot_version() >= (2, 4):
        return f"userdb_quota_storage_size={q}"
    return f"userdb_quota_rule=*:storage={q}"


def parse_quota(extra):
    m = re.search(r"userdb_quota_storage_size=(\S+)", extra) or \
        re.search(r"userdb_quota_rule=\*:storage=(\S+)", extra)
    return m.group(1) if m else ""


def read_users():
    users = []
    try:
        with open(USERS_FILE) as f:
            for line in f:
                line = line.rstrip("\n")
                if not line.strip():
                    continue
                parts = line.split(":", 7)
                parts += [""] * (8 - len(parts))
                users.append({"email": parts[0], "hash": parts[1], "quota": parse_quota(parts[7])})
    except FileNotFoundError:
        pass
    return users


def local_nets():
    """Where the mailbox password still works once a mailbox requires app
    passwords: webmail and the dashboard (both connect from this server) and
    doveadm ("local" = no remote address)."""
    nets = ["local", "127.0.0.0/8", "::1"]
    return nets + [ip for ip in (C.get("SERVER_IPV4"), C.get("SERVER_IPV6")) if ip]


def user_extra(u, apps_only):
    fields = [quota_field(u["quota"])] if u["quota"] else []
    if apps_only:
        fields.append("allow_nets=" + ",".join(local_nets()))
    return " ".join(fields)


def write_users(users):
    """Atomically replace the users file.

    Dovecot re-reads it when its size or modification time (whole seconds)
    changes, so make sure the modification time always moves forward.
    """
    old = int(os.stat(USERS_FILE).st_mtime) if os.path.exists(USERS_FILE) else 0
    apps_only = apppw_required()
    text = "".join(f"{u['email']}:{u['hash']}::::::{user_extra(u, u['email'] in apps_only)}\n"
                   for u in users)
    write_file(USERS_FILE, text, mode=0o640, like=USERS_FILE)
    if int(os.stat(USERS_FILE).st_mtime) <= old:
        os.utime(USERS_FILE, (old + 1, old + 1))


def dovecot_sees(email, password=None, deleted=False):
    """True once Dovecot serves the current users file for this mailbox."""
    if deleted:
        p = run(["doveadm", "user", email], check=False, timeout=15)
        return p.returncode != 0 and "doesn't exist" in (p.stdout + p.stderr)
    if password is not None:
        p = run(["doveadm", "auth", "test", email, password], check=False, timeout=30)
        return p.returncode == 0
    return run(["doveadm", "user", email], check=False, timeout=15).returncode == 0


def sync_dovecot(email, password=None, deleted=False):
    """Return only once Dovecot really uses the change.

    Dovecot re-reads the users file at most once per second, so a lookup made
    earlier in the same second as a change (e.g. checking the old password
    just before setting a new one) keeps seeing the old file until the next
    second. Wait for that, then prove the change is live; nudge the file's
    timestamp and retry, and as a last resort reload Dovecot.
    """
    if not shutil.which("doveadm"):
        return
    for attempt in range(3):
        time.sleep(1.05 - time.time() % 1)
        if dovecot_sees(email, password, deleted):
            return
        t = time.time() + 1
        os.utime(USERS_FILE, (t, t))
    run(["doveadm", "reload"], check=False)
    time.sleep(1.5)


def find_user(users, email):
    return next((u for u in users if u["email"] == email), None)


def read_password(email):
    if sys.stdin.isatty():
        pw = getpass.getpass(f"Password for {email}: ")
        if pw != getpass.getpass("Repeat password: "):
            raise Fail("passwords do not match")
    else:
        pw = sys.stdin.readline().rstrip("\n")
    if len(pw) < 10:
        raise Fail("password must be at least 10 characters")
    if ":" in pw:
        raise Fail("password must not contain ':'")
    return pw


def hash_password(pw):
    # The password goes in on stdin so it never shows up in the process list.
    p = run(["openssl", "passwd", "-6", "-stdin"], input=pw + "\n")
    return "{SHA512-CRYPT}" + p.stdout.strip()


def verify_password(pw, stored):
    """True if pw matches a hash written by hash_password."""
    m = re.fullmatch(r"\{(?:SHA512-CRYPT|SHA256-CRYPT|CRYPT)\}(\$([56])\$([^$]{1,16})\$[./0-9A-Za-z]+)",
                     stored or "")
    if not m or "\n" in pw:
        return False
    p = run(["openssl", "passwd", f"-{m.group(2)}", "-salt", m.group(3), "-stdin"],
            input=pw + "\n", check=False)
    return p.returncode == 0 and hmac.compare_digest(p.stdout.strip(), m.group(1))


def quota_usage():
    """{email: {"used": bytes, "messages": n}} for every mailbox, from Dovecot."""
    usage = {}
    p = run(["doveadm", "-f", "tab", "quota", "get", "-A"], check=False, timeout=120)
    if p.returncode != 0:
        return usage
    for line in p.stdout.splitlines()[1:]:
        cols = line.split("\t")
        if len(cols) < 5:
            continue
        email, _, kind, value = cols[:4]
        u = usage.setdefault(email, {"used": 0, "messages": 0})
        if kind == "STORAGE" and value.isdigit():
            u["used"] = int(value) * 1024
        elif kind == "MESSAGE" and value.isdigit():
            u["messages"] = int(value)
    return usage


# ------------------------------------------------------------------ users

def user_add(email, quota=None):
    email = lower_email(email)
    if domain_of(email) not in map_keys(VDOMAINS):
        raise Fail(f"domain {domain_of(email)} is not hosted here (mailctl domain add ...)")
    users = read_users()
    if find_user(users, email):
        raise Fail(f"{email} already exists")
    if email in map_keys(VALIASES):
        raise Fail(f"{email} is already an alias")
    q = normalize_quota(C.get("DEFAULT_QUOTA", "") if quota is None else quota)
    pw = read_password(email)
    h = hash_password(pw)
    users.append({"email": email, "hash": h, "quota": q})
    write_users(users)
    sync_dovecot(email, password=pw)
    write_map(VMAILBOX, read_map(VMAILBOX) + [(email, "OK")])
    postmap_all()
    # Create the mailbox right away so the default folders exist.
    run(["doveadm", "mailbox", "list", "-u", email], check=False)
    audit(f"user add {email} quota={q or 'unlimited'}")
    info(f"created mailbox {email}" + (f" (quota {q})" if q else ""))
    return {"email": email, "quota": q}


def user_passwd(email):
    email = lower_email(email)
    users = read_users()
    u = find_user(users, email)
    if not u:
        raise Fail(f"no such mailbox: {email}")
    pw = read_password(email)
    u["hash"] = hash_password(pw)
    write_users(users)
    sync_dovecot(email, password=pw)
    # Like Google and Apple: a new password also signs out every app password,
    # in case whoever knew the old one created some.
    revoked = apppw_clear(email)
    audit(f"user passwd {email}" + (f" (revoked {revoked} app password(s))" if revoked else ""))
    info(f"password changed for {email}" + (f"; {revoked} app password(s) removed" if revoked else ""))
    return {"email": email, "app_passwords_removed": revoked}


def user_quota(email, quota):
    email = lower_email(email)
    users = read_users()
    u = find_user(users, email)
    if not u:
        raise Fail(f"no such mailbox: {email}")
    u["quota"] = normalize_quota(quota)
    write_users(users)
    audit(f"user quota {email} {u['quota'] or 'unlimited'}")
    info(f"quota for {email}: {u['quota'] or 'unlimited'}")
    return {"email": email, "quota": u["quota"]}


def user_del(email, purge=False):
    email = lower_email(email)
    users = read_users()
    if not find_user(users, email):
        raise Fail(f"no such mailbox: {email}")
    write_users([u for u in users if u["email"] != email])
    sync_dovecot(email, deleted=True)
    write_map(VMAILBOX, [r for r in read_map(VMAILBOX) if r[0] != email])
    postmap_all()
    run(["doveadm", "kick", email], check=False)
    admins = read_admins()
    if email in admins:
        write_admins([a for a in admins if a != email])
    forget_user(email)
    d = os.path.join(VMAIL_DIR, domain_of(email), email.split("@")[0])
    if purge:
        shutil.rmtree(d, ignore_errors=True)
        shutil.rmtree(os.path.join("/var/lib/radicale/collections/collection-root", email),
                      ignore_errors=True)
        info(f"removed mailbox {email} and deleted its mail")
    else:
        info(f"removed mailbox {email} (mail kept in {d}; use --purge to delete)")
    audit(f"user del {email}" + (" --purge" if purge else ""))
    return {"email": email, "purged": purge}


def user_list():
    usage = quota_usage()
    admins = set(read_admins())
    apps = apppw_load()
    out = []
    for u in read_users():
        us = usage.get(u["email"])
        if us is None:
            d = os.path.join(VMAIL_DIR, domain_of(u["email"]), u["email"].split("@")[0])
            p = run(["du", "-sb", d], check=False)
            us = {"used": int(p.stdout.split()[0]) if p.returncode == 0 and p.stdout else 0,
                  "messages": None}
        out.append({"email": u["email"], "quota": u["quota"],
                    "quota_bytes": quota_to_bytes(u["quota"]),
                    "used_bytes": us["used"], "messages": us["messages"],
                    "admin": u["email"] in admins,
                    "app_passwords": len(apps.get(u["email"], {}).get("passwords", [])),
                    "app_only": bool(apps.get(u["email"], {}).get("required"))})
    return out


def user_info(email):
    email = lower_email(email)
    for u in user_list():
        if u["email"] == email:
            u["aliases"] = [a["alias"] for a in alias_list() if email in a["destinations"]]
            return u
    raise Fail(f"no such mailbox: {email}")


# ------------------------------------------------------------------ aliases

def alias_add(alias, dests):
    alias = (alias or "").strip().lower()
    if alias.startswith("@"):
        lower_domain(alias[1:])
    else:
        alias = lower_email(alias, "alias address")
    if domain_of(alias) not in map_keys(VDOMAINS):
        raise Fail(f"domain {domain_of(alias)} is not hosted here")
    if find_user(read_users(), alias):
        raise Fail(f"{alias} is a mailbox; delete it first or pick another address")
    if alias in map_keys(VALIASES):
        raise Fail(f"alias {alias} already exists (delete it first to change it)")
    targets = [lower_email(d, "destination address")
               for d in re.split(r"[,\s]+", (dests or "").strip()) if d]
    if not targets:
        raise Fail("usage: mailctl alias add <alias> <dest>[,<dest>...]")
    targets = list(dict.fromkeys(targets))
    write_map(VALIASES, read_map(VALIASES) + [(alias, ",".join(targets))])
    postmap_all()
    audit(f"alias add {alias} -> {','.join(targets)}")
    info(f"alias {alias} -> {','.join(targets)}")
    return {"alias": alias, "destinations": targets}


def alias_del(alias):
    alias = (alias or "").strip().lower()
    if alias not in map_keys(VALIASES):
        raise Fail(f"no such alias: {alias or '<none>'}")
    write_map(VALIASES, [r for r in read_map(VALIASES) if r[0] != alias])
    postmap_all()
    temps = read_json(TEMP_FILE, {})
    if temps.pop(alias, None) is not None:
        write_json(TEMP_FILE, temps, group="mail-dashboard")
    audit(f"alias del {alias}")
    info(f"removed alias {alias}")
    return {"alias": alias}


def alias_list():
    return [{"alias": k, "destinations": v.split(",")} for k, v in read_map(VALIASES)]


# ------------------------------------------------------------------ domains

def dkim_key_path(domain):
    return os.path.join(DKIM_DIR, f"{domain}.{C['DKIM_SELECTOR']}.key")


def dkim_public(domain):
    key = dkim_key_path(domain)
    if not os.path.exists(key):
        return None
    p = subprocess.run(["openssl", "pkey", "-in", key, "-pubout", "-outform", "DER"],
                       capture_output=True)
    return base64.b64encode(p.stdout).decode() if p.returncode == 0 else None


def domain_add(domain):
    domain = lower_domain(domain)
    if domain in map_keys(VDOMAINS):
        raise Fail(f"{domain} is already hosted here")
    key = dkim_key_path(domain)
    os.makedirs(DKIM_DIR, exist_ok=True)
    if not os.path.exists(key):
        run(["rspamadm", "dkim_keygen", "-b", "2048", "-s", C["DKIM_SELECTOR"],
             "-d", domain, "-k", key])
        shutil.chown(key, "_rspamd", "_rspamd")
        os.chmod(key, 0o640)
    write_map(VDOMAINS, read_map(VDOMAINS) + [(domain, "OK")])
    d = os.path.join(VMAIL_DIR, domain)
    os.makedirs(d, exist_ok=True)
    shutil.chown(d, "vmail", "vmail")
    os.chmod(d, 0o750)
    # Standard role addresses (RFC 2142) go to the administrator.
    users = {u["email"] for u in read_users()}
    aliases = read_map(VALIASES)
    keys = {k for k, _ in aliases}
    for role in ("postmaster", "abuse"):
        a = f"{role}@{domain}"
        if a not in users and a not in keys and C.get("ADMIN_EMAIL"):
            aliases.append((a, C["ADMIN_EMAIL"]))
    # DMARC aggregate reports are read by the dashboard, not a person.
    if f"dmarc-reports@{domain}" not in users and f"dmarc-reports@{domain}" not in keys:
        aliases.append((f"dmarc-reports@{domain}", DMARC_ADDRESS))
    write_map(VALIASES, aliases)
    # Rspamd reads the key file when it signs, so no reload is needed.
    postmap_all()
    audit(f"domain add {domain}")
    info(f"now hosting {domain}")
    return {"domain": domain, "records": dns_records(domain)}


def domain_del(domain):
    domain = lower_domain(domain)
    if domain not in map_keys(VDOMAINS):
        raise Fail(f"no such domain: {domain}")
    if domain == C["DOMAIN"]:
        raise Fail(f"refusing to remove the primary domain {domain}")
    if any(domain_of(u["email"]) == domain for u in read_users()):
        raise Fail(f"{domain} still has mailboxes; delete them first (mailctl user list)")
    write_map(VDOMAINS, [r for r in read_map(VDOMAINS) if r[0] != domain])
    write_map(VALIASES, [r for r in read_map(VALIASES) if domain_of(r[0]) != domain])
    postmap_all()
    audit(f"domain del {domain}")
    info(f"stopped hosting {domain} (DKIM key kept in {DKIM_DIR})")
    return {"domain": domain}


def domain_list():
    users = read_users()
    aliases = read_map(VALIASES)
    return [{"domain": d, "primary": d == C["DOMAIN"],
             "mailboxes": sum(1 for u in users if domain_of(u["email"]) == d),
             "aliases": sum(1 for k, _ in aliases if domain_of(k) == d)}
            for d, _ in read_map(VDOMAINS)]


# ------------------------------------------------------------------ DNS

def mta_sts_id():
    try:
        mtime = os.stat(MTA_STS_FILE).st_mtime
    except FileNotFoundError:
        return "1"
    return datetime.datetime.fromtimestamp(mtime).strftime("%Y%m%d%H%M%S")


def dns_records(domain=None):
    """The DNS records a domain needs."""
    domain = lower_domain(domain or C["DOMAIN"])
    if domain not in map_keys(VDOMAINS):
        raise Fail(f"{domain} is not hosted here")
    host = C["MAIL_HOSTNAME"]
    recs = []

    def add(rtype, name, value, purpose, required=True, fqdn=None):
        if fqdn is None:
            fqdn = domain if name == "@" else f"{name}.{domain}"
        recs.append({"type": rtype, "name": name, "fqdn": fqdn, "value": value,
                     "purpose": purpose, "required": required})

    if domain == C["DOMAIN"]:
        add("A", host + ".", C["SERVER_IPV4"], "Where the mail server is", fqdn=host)
        if C.get("SERVER_IPV6"):
            add("AAAA", host + ".", C["SERVER_IPV6"], "Mail server (IPv6)", fqdn=host)
    add("MX", "@", f"10 {host}.", "Mail for this domain goes to this server")
    relay_spf = (load_settings().get("relay") or {}).get("spf", "")
    add("TXT", "@", f"v=spf1 mx {relay_spf + ' ' if relay_spf else ''}-all",
        "SPF: only this server (and your relay service) may send for the domain")
    pub = dkim_public(domain)
    if pub:
        add("TXT", f"{C['DKIM_SELECTOR']}._domainkey", f"v=DKIM1; k=rsa; p={pub}",
            "DKIM: proves mail really came from you")
    add("TXT", "_dmarc", f"v=DMARC1; p=quarantine; rua=mailto:dmarc-reports@{domain}; adkim=r; aspf=r",
        "DMARC: tells receivers what to do with forged mail")
    if C.get("ENABLE_MTA_STS") == "yes":
        add("CNAME", "mta-sts", f"{host}.", "MTA-STS policy host", required=False)
        add("TXT", "_mta-sts", f"v=STSv1; id={mta_sts_id()}",
            "MTA-STS: senders must use encrypted connections", required=False)
        add("TXT", "_smtp._tls", f"v=TLSRPTv1; rua=mailto:postmaster@{domain}",
            "TLS-RPT: reports about encryption problems", required=False)
    add("SRV", "_imaps._tcp", f"0 1 993 {host}.", "Mail app auto-setup (IMAP)", required=False)
    add("SRV", "_submissions._tcp", f"0 1 465 {host}.", "Mail app auto-setup (SMTP)", required=False)
    add("SRV", "_submission._tcp", f"0 1 587 {host}.", "Mail app auto-setup (SMTP)", required=False)
    add("CNAME", "autoconfig", f"{host}.", "Thunderbird auto-setup", required=False)
    add("CNAME", "autodiscover", f"{host}.", "Outlook auto-setup", required=False)
    if C.get("ENABLE_DAV") == "yes":
        add("SRV", "_caldavs._tcp", f"0 1 443 {host}.", "Calendar auto-setup", required=False)
        add("SRV", "_carddavs._tcp", f"0 1 443 {host}.", "Contacts auto-setup", required=False)
    return recs


def dig(name, rtype, server=None):
    """Answers for a DNS query: a list (empty if the name has no such record),
    or None when the lookup itself failed (timeout, SERVFAIL...)."""
    cmd = ["dig", "+noall", "+answer", "+comments", "+time=3", "+tries=2", rtype, name]
    if server:
        cmd.insert(1, f"@{server}")
    p = run(cmd, check=False, timeout=20)
    m = re.search(r"status: (\w+)", p.stdout or "")
    if p.returncode != 0 or not m or m.group(1) not in ("NOERROR", "NXDOMAIN"):
        return None
    out = []
    for line in p.stdout.splitlines():
        parts = line.split(None, 4)
        if line.startswith(";") or len(parts) < 5 or parts[3] != rtype:
            continue
        value = parts[4].strip()
        if rtype == "TXT":
            value = "".join(re.findall(r'"((?:[^"\\]|\\.)*)"', value))
        out.append(value)
    return out


def check_record(rec):
    host = C["MAIL_HOSTNAME"]
    t, want = rec["type"], rec["value"]
    found = dig(rec["fqdn"], "A" if t == "CNAME" else t)
    if found is None:
        return "warn", "DNS lookup failed", []
    status, note = "ok", ""
    if t in ("A", "AAAA"):
        if want not in found:
            status, note = "error", "does not point to this server"
    elif t == "MX":
        targets = [x.split()[-1].rstrip(".").lower() for x in found if x.split()]
        if host not in targets:
            status, note = "error", f"MX must point to {host}"
    elif t == "TXT":
        prefix = want.split(";")[0].split(" ")[0]
        found = [x for x in found if x.startswith(prefix)]
        if not found:
            status, note = "error", "missing"
        elif prefix == "v=spf1":
            spf = found[0]
            if len(found) > 1:
                status, note = "error", "more than one SPF record"
            elif not (re.search(r"(^|\s)\+?mx(\s|$)", spf) or f"ip4:{C['SERVER_IPV4']}" in spf
                      or f"a:{host}" in spf):
                status, note = "error", "SPF does not allow this server"
        elif prefix == "v=DKIM1":
            want_p = want.split("p=", 1)[1]
            if not any(x.replace(" ", "").endswith("p=" + want_p) for x in found):
                status, note = "error", "key does not match this server's DKIM key"
        elif prefix == "v=STSv1" and want not in found:
            status, note = "warn", "id differs from the current policy; update it"
    elif t == "CNAME":
        if C["SERVER_IPV4"] not in found:
            status, note = "error", "does not point to this server"
    elif t == "SRV":
        if not any(x.rstrip(".").lower().endswith(host) for x in found):
            status, note = "error", "missing"
    if status == "error" and not rec["required"]:
        status = "warn"
    return status, note, found


def dns_check(domain=None):
    domain = lower_domain(domain or C["DOMAIN"])
    results = []
    for rec in dns_records(domain):
        status, note, found = check_record(rec)
        results.append(dict(rec, status=status, note=note, found=found))
    if domain == C["DOMAIN"]:
        ptr = dig(ipaddress.ip_address(C["SERVER_IPV4"]).reverse_pointer, "PTR") or []
        ok = any(x.rstrip(".").lower() == C["MAIL_HOSTNAME"] for x in ptr)
        results.append({"type": "PTR", "name": C["SERVER_IPV4"], "fqdn": C["SERVER_IPV4"],
                        "value": C["MAIL_HOSTNAME"], "required": True,
                        "purpose": "Reverse DNS - set at your hosting provider",
                        "status": "ok" if ok else "error",
                        "note": "" if ok else "set it in your hosting provider's control panel",
                        "found": ptr})
    return results


# ------------------------------------------------------------------ status & checks

def service_state(name):
    p = run(["systemctl", "show", "-p", "LoadState", "--value", name], check=False)
    if p.stdout.strip() != "loaded":
        return None
    return run(["systemctl", "is-active", name], check=False).stdout.strip() or "unknown"


def php_fpm_unit():
    p = run(["systemctl", "list-units", "--type=service", "--all", "--no-legend", "--plain",
             "php*-fpm.service"], check=False)
    for line in p.stdout.splitlines():
        if line.split():
            return line.split()[0].removesuffix(".service")
    return None


def cert_info():
    p = run(["postconf", "-h", "smtpd_tls_chain_files"], check=False)
    parts = [x.strip() for x in p.stdout.split(",")]
    cert = parts[1] if len(parts) > 1 else ""
    if not cert or not os.path.exists(cert):
        return None
    end = run(["openssl", "x509", "-in", cert, "-noout", "-enddate"], check=False).stdout
    san = run(["openssl", "x509", "-in", cert, "-noout", "-ext", "subjectAltName"], check=False).stdout
    issuer = run(["openssl", "x509", "-in", cert, "-noout", "-issuer"], check=False).stdout
    exp = end.strip().split("=", 1)[-1]
    try:
        dt = datetime.datetime.strptime(exp, "%b %d %H:%M:%S %Y %Z")
        days = (dt - datetime.datetime.now(datetime.timezone.utc).replace(tzinfo=None)).days
    except ValueError:
        dt, days = None, None
    m = re.search(r"O\s*=\s*([^,]+)", issuer) or re.search(r"CN\s*=\s*([^,]+)", issuer)
    return {"path": cert, "expires": dt.isoformat() if dt else exp, "days_left": days,
            "names": re.findall(r"DNS:([^,\s]+)", san),
            "issuer": m.group(1).strip() if m else issuer.strip()}


def queue_list():
    p = run(["postqueue", "-j"], check=False)
    items = []
    for line in p.stdout.splitlines():
        try:
            m = json.loads(line)
        except ValueError:
            continue
        items.append({
            "id": m.get("queue_id"), "queue": m.get("queue_name"),
            "arrival": datetime.datetime.fromtimestamp(m.get("arrival_time", 0)).isoformat(),
            "size": m.get("message_size"), "sender": m.get("sender"),
            "recipients": [{"address": r.get("address"), "reason": r.get("delay_reason", "")}
                           for r in m.get("recipients", [])]})
    return items


def status():
    services = {}
    for s in SERVICES:
        st = service_state(s)
        if st is not None:
            services[s] = st
    fpm = php_fpm_unit()
    if fpm:
        services[fpm] = run(["systemctl", "is-active", fpm], check=False).stdout.strip()
    du = shutil.disk_usage(VMAIL_DIR if os.path.isdir(VMAIL_DIR) else "/")
    vm = run(["du", "-sb", VMAIL_DIR], check=False).stdout.split()
    mem = {}
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                mem[k] = int(v.split()[0]) * 1024
    except OSError:
        pass
    try:
        with open("/proc/uptime") as f:
            uptime = float(f.read().split()[0])
    except OSError:
        uptime = 0
    return {
        "hostname": C["MAIL_HOSTNAME"], "primary_domain": C["DOMAIN"],
        "server_ipv4": C["SERVER_IPV4"],
        "services": services, "certificate": cert_info(),
        "counts": {"domains": len(read_map(VDOMAINS)), "mailboxes": len(read_users()),
                   "aliases": len(read_map(VALIASES)), "queue": len(queue_list())},
        "disk": {"total": du.total, "free": du.free, "vmail": int(vm[0]) if vm else 0},
        "memory": {"total": mem.get("MemTotal", 0), "available": mem.get("MemAvailable", 0)},
        "load": list(os.getloadavg()), "cpus": os.cpu_count(),
        "uptime_seconds": int(uptime),
        "reboot_required": os.path.exists("/var/run/reboot-required"),
    }


def blocklist_check():
    rev = ".".join(reversed(C["SERVER_IPV4"].split(".")))
    p = run(["dig", "@127.0.0.1", "+time=3", "+tries=2", "A", f"{rev}.zen.spamhaus.org"],
            check=False, timeout=20)
    m = re.search(r"status: (\w+)", p.stdout or "")
    if p.returncode != 0 or not m or m.group(1) not in ("NOERROR", "NXDOMAIN"):
        return "warn", "could not query Spamhaus (DNS lookup failed)"
    if m.group(1) == "NXDOMAIN":
        return "ok", "not listed on Spamhaus ZEN"
    res = re.findall(r"\sIN\s+A\s+(\S+)", p.stdout)
    if not res:
        return "ok", "not listed on Spamhaus ZEN"
    if any(x.startswith("127.255.255.") for x in res):
        return "warn", "Spamhaus refused the query"
    return "error", f"listed on Spamhaus ZEN ({', '.join(res)}) - see https://check.spamhaus.org/"


def port25_out():
    try:
        with socket.create_connection(("gmail-smtp-in.l.google.com", 25), timeout=8):
            return True
    except OSError:
        return False


def dnssec_validating():
    """True if the system resolver, which Postfix uses, checks DNSSEC."""
    p = run(["dig", "+dnssec", "+time=3", "+tries=2", ".", "SOA"], check=False, timeout=20)
    m = re.search(r"^;; flags:([a-z ]*);", p.stdout or "", re.M)
    return bool(m) and "ad" in m.group(1).split()


def checks(include_dns=True):
    """Health checks, in the spirit of Mail-in-a-Box's status page."""
    out = []

    def add(group, name, st, detail=""):
        out.append({"group": group, "name": name, "status": st, "detail": detail})

    st = status()
    for s, state in st["services"].items():
        if s == "clamav-daemon" and state != "active":
            add("Services", s, "warn", "starts once virus signatures are downloaded")
        else:
            add("Services", s, "ok" if state == "active" else "error", state)

    for port, name in ((25, "SMTP"), (465, "SMTPS"), (587, "Submission"), (993, "IMAPS"), (443, "HTTPS")):
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=3):
                add("Network", f"port {port} ({name})", "ok", "listening")
        except OSError:
            add("Network", f"port {port} ({name})", "error", "not listening")
    relay = relay_status()
    if relay["enabled"]:
        try:
            with socket.create_connection((relay["host"], relay["port"]), timeout=8):
                add("Network", "relay service", "ok", f"{relay['host']}:{relay['port']} reachable")
        except OSError:
            add("Network", "relay service", "error", f"cannot reach {relay['host']}:{relay['port']}")
    else:
        out25 = port25_out()
        add("Network", "outgoing port 25", "ok" if out25 else "error",
            "can reach other mail servers" if out25
            else "blocked - ask your hosting provider to open outbound port 25, or use a relay service")
    s, d = blocklist_check()
    add("Network", f"IP {C['SERVER_IPV4']} reputation", s, d)
    if run(["postconf", "-h", "smtp_tls_policy_maps"], check=False).stdout.strip():
        p = run(["postmap", "-q", C["DOMAIN"], "socketmap:inet:127.0.0.1:8461:postfix"], check=False, timeout=20)
        broken = "fatal" in (p.stderr + p.stdout)
        add("Mail", "MTA-STS resolver", "error" if broken else "ok",
            "not answering - outgoing mail is stuck (systemctl restart postfix-mta-sts-resolver)"
            if broken else "answering")
    if not relay["enabled"]:
        level = run(["postconf", "-h", "smtp_tls_security_level"], check=False).stdout.strip()
        if level == "dane":
            ok = dnssec_validating()
            add("Mail", "DANE for outgoing mail", "ok" if ok else "error",
                "domains that publish TLSA records only get mail over verified encryption" if ok else
                "the DNS resolver does not check DNSSEC, so DANE is ignored (systemctl status unbound)")
        elif C.get("ENABLE_DANE", "yes") == "yes":
            add("Mail", "DANE for outgoing mail", "warn",
                "off: the local resolver could not check DNSSEC when install.sh ran; run it again")

    cert = st["certificate"]
    if not cert:
        add("Security", "TLS certificate", "error", "not found")
    else:
        days = cert["days_left"]
        s = "ok" if days is not None and days > 14 else ("warn" if days and days > 3 else "error")
        add("Security", "TLS certificate", s, f"{cert['issuer']}, expires in {days} days")
        if C["MAIL_HOSTNAME"] not in cert["names"]:
            add("Security", "certificate name", "error", f"does not cover {C['MAIL_HOSTNAME']}")
        if C["CERT_MODE"] == "selfsigned":
            add("Security", "certificate type", "warn", "self-signed: mail apps will show warnings")
    admins = read_admins()
    add("Security", "dashboard admins", "ok" if admins else "warn",
        ", ".join(admins) if admins else "none (mailctl admin add <email>)")

    if st["reboot_required"]:
        add("System", "reboot", "warn", "updates are installed that need a reboot")
    free_pct = st["disk"]["free"] * 100 / max(st["disk"]["total"], 1)
    add("System", "disk space", "ok" if free_pct > 10 else ("warn" if free_pct > 5 else "error"),
        f"{free_pct:.0f}% free ({human_bytes(st['disk']['free'])})")
    mem = st["memory"]
    if mem.get("total"):
        avail = mem["available"] * 100 / mem["total"]
        add("System", "memory", "ok" if avail > 10 else "warn", f"{avail:.0f}% available")
    backups = backup_list()
    if not backups:
        add("System", "backups", "warn", "no backup yet")
    else:
        age = (datetime.datetime.now() - datetime.datetime.fromisoformat(backups[0]["created"])).days
        add("System", "backups", "ok" if age <= 2 else "warn",
            f"last backup {backups[0]['created'][:16].replace('T', ' ')}")
    q = st["counts"]["queue"]
    add("Mail", "outgoing queue", "ok" if q < 20 else "warn", f"{q} message(s) waiting")

    if include_dns:
        for d, _ in read_map(VDOMAINS):
            for r in dns_check(d):
                add(f"DNS: {d}", f"{r['type']} {r['name']}", r["status"], r["note"] or r["purpose"])
    return out


# ------------------------------------------------------------------ queue, bans, logs

def queue_action(action, qid=None):
    if action == "flush":
        run(["postqueue", "-f"])
        audit("queue flush")
        info("retrying delivery of all queued mail")
        return {"action": action}
    if action not in ("delete", "hold", "release", "requeue"):
        raise Fail(f"unknown queue action: {action}")
    if not qid or not (qid == "ALL" or QUEUE_ID_RE.match(qid)):
        raise Fail("give a queue ID (or ALL)")
    flag = {"delete": "-d", "hold": "-h", "release": "-H", "requeue": "-r"}[action]
    run(["postsuper", flag, qid])
    audit(f"queue {action} {qid}")
    info(f"queue {action} {qid}")
    return {"action": action, "id": qid}


def bans():
    p = run(["fail2ban-client", "status"], check=False)
    m = re.search(r"Jail list:\s*(.*)", p.stdout)
    jails = [j.strip() for j in m.group(1).split(",") if j.strip()] if m else []
    out = []
    for j in jails:
        s = run(["fail2ban-client", "status", j], check=False).stdout
        ips = re.search(r"Banned IP list:\s*(.*)", s)
        failed = re.search(r"Total failed:\s*(\d+)", s)
        banned = re.search(r"Total banned:\s*(\d+)", s)
        out.append({"jail": j, "banned": ips.group(1).split() if ips else [],
                    "total_failed": int(failed.group(1)) if failed else 0,
                    "total_banned": int(banned.group(1)) if banned else 0})
    return out


def unban(ip):
    try:
        ipaddress.ip_address(ip or "")
    except ValueError:
        raise Fail(f"invalid IP address: {ip}")
    run(["fail2ban-client", "unban", ip])
    audit(f"unban {ip}")
    info(f"unbanned {ip}")
    return {"ip": ip}


LOG_UNITS = {
    "mail": ["postfix@-.service", "dovecot.service"],
    "postfix": ["postfix@-.service"],
    "dovecot": ["dovecot.service"],
    "security": ["fail2ban.service"],
    "web": ["nginx.service", "mail-dashboard.service"],
}


def logs(kind="mail", lines=200, grep=None):
    lines = max(1, min(int(lines), 5000))
    fetch = lines * 5 if grep else lines
    if kind == "spam":
        out = run(["tail", "-n", str(fetch), "/var/log/rspamd/rspamd.log"], check=False).stdout.splitlines()
    elif kind == "audit":
        out = run(["tail", "-n", str(fetch), AUDIT_LOG], check=False).stdout.splitlines()
    else:
        units = LOG_UNITS.get(kind)
        if not units:
            raise Fail(f"unknown log: {kind} (use: mail, postfix, dovecot, spam, security, web, audit)")
        cmd = ["journalctl", "--no-pager", "-o", "short-iso", "-n", str(fetch)]
        for u in units:
            cmd += ["-u", u]
        out = run(cmd, check=False).stdout.splitlines()
    if grep:
        g = grep.lower()
        out = [x for x in out if g in x.lower()]
    return out[-lines:]


# ------------------------------------------------------------------ backups

def backup_list():
    out = []
    for f in sorted(glob.glob(os.path.join(C["BACKUP_DIR"], "mail-backup-*.tar.gz")), reverse=True):
        st = os.stat(f)
        out.append({"file": os.path.basename(f), "size": st.st_size,
                    "created": datetime.datetime.fromtimestamp(st.st_mtime).isoformat()})
    return out


def backup_run(background=False):
    audit("backup run")
    if background:
        started = shutil.which("systemd-run") and run(
            ["systemd-run", "--unit", f"mail-backup-{int(time.time())}", "--collect",
             "/usr/local/sbin/mail-backup"], check=False).returncode == 0
        if not started:
            subprocess.Popen(["/usr/local/sbin/mail-backup"], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        info("backup started in the background")
        return {"started": True}
    p = run(["/usr/local/sbin/mail-backup"], timeout=86400)
    info(p.stdout.strip())
    return {"output": p.stdout.strip()}


# ------------------------------------------------------------------ dashboard admins

def read_admins():
    try:
        with open(ADMINS_FILE) as f:
            return [x.strip().lower() for x in f if x.strip() and not x.startswith("#")]
    except FileNotFoundError:
        return []


def write_admins(admins):
    text = "# Mailboxes allowed to use the admin dashboard (managed by mailctl)\n"
    text += "".join(f"{a}\n" for a in dict.fromkeys(admins))
    write_file(ADMINS_FILE, text, mode=0o640, like=ADMINS_FILE)


def admin_add(email):
    email = lower_email(email)
    if not find_user(read_users(), email):
        raise Fail(f"{email} is not a mailbox on this server")
    admins = read_admins()
    if email not in admins:
        write_admins(admins + [email])
    audit(f"admin add {email}")
    info(f"{email} can now use the admin dashboard")
    return {"email": email}


def admin_del(email):
    email = lower_email(email)
    admins = read_admins()
    if email not in admins:
        raise Fail(f"{email} is not an admin")
    if len(admins) == 1:
        raise Fail("refusing to remove the last admin")
    write_admins([a for a in admins if a != email])
    audit(f"admin del {email}")
    info(f"{email} is no longer an admin")
    return {"email": email}


# ------------------------------------------------------------------ certificate

def cert_refresh():
    """Get or extend the certificate: the mail host plus every mta-sts,
    autoconfig and autodiscover name that already points at this server."""
    if C["CERT_MODE"] != "letsencrypt":
        info("self-signed certificate mode: nothing to do")
        return {"changed": False, "names": (cert_info() or {}).get("names", [])}
    names = [C["MAIL_HOSTNAME"]]
    for d, _ in read_map(VDOMAINS):
        for sub in ("mta-sts", "autoconfig", "autodiscover"):
            n = f"{sub}.{d}"
            if C["SERVER_IPV4"] in (dig(n, "A") or []):
                names.append(n)
    current = (cert_info() or {}).get("names", [])
    if set(names) <= set(current):
        info("certificate already covers: " + ", ".join(current))
        return {"changed": False, "names": current}
    cmd = ["certbot", "certonly", "--webroot", "-w", "/var/www/letsencrypt",
           "--cert-name", C["MAIL_HOSTNAME"], "--non-interactive", "--agree-tos",
           "--keep-until-expiring", "--expand", "--no-eff-email",
           "--email", C.get("LETSENCRYPT_EMAIL") or C["ADMIN_EMAIL"]]
    for n in names:
        cmd += ["-d", n]
    run(cmd, timeout=600)
    run(["systemctl", "reload", "postfix", "dovecot", "nginx"], check=False)
    audit("cert refresh " + ",".join(names))
    info("certificate now covers: " + ", ".join(names))
    return {"changed": True, "names": names}


def migrate():
    """Rewrite the users file for the installed Dovecot version (after upgrades)
    and Dovecot's app password files (e.g. after restoring a backup)."""
    if os.path.exists(USERS_FILE):
        write_users(read_users())
    if os.path.exists(APP_PW_FILE):
        apppw_write(apppw_load())
    aliases = read_map(VALIASES)
    keys = {k for k, _ in aliases}
    added = [(f"dmarc-reports@{d}", DMARC_ADDRESS) for d, _ in read_map(VDOMAINS)
             if f"dmarc-reports@{d}" not in keys]
    if added:
        write_map(VALIASES, aliases + added)
        postmap_all()
    return {}


# ------------------------------------------------------------------ settings

SETTINGS_FILE = "/etc/mail-server/settings.json"
SASL_PASSWD = "/etc/postfix/sasl_passwd"
RATELIMIT_CONF = "/etc/rspamd/local.d/ratelimit.conf"
TEMP_FILE = "/etc/mail-server/temp-aliases.json"
SHARES_FILE = "/etc/mail-server/shares.json"
STATE_DIR = "/var/lib/mail-server"
HOST_RE = re.compile(r"^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$")
SPF_TERM_RE = re.compile(r"^(include:[a-z0-9._-]+|ip4:[0-9./]+|ip6:[0-9a-f:./]+|a:[a-z0-9._-]+|mx:[a-z0-9._-]+)$")
UID_RE = re.compile(r"^[0-9]{1,10}$")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data, mode=0o640, group=None):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    write_file(path, json.dumps(data, indent=2, sort_keys=True) + "\n", mode=mode,
               like=path if os.path.exists(path) else None)
    if group:
        try:
            shutil.chown(path, "root", group)
        except (LookupError, OSError):
            pass


def load_settings():
    return read_json(SETTINGS_FILE, {})


def save_settings(s):
    write_json(SETTINGS_FILE, s, group="mail-dashboard")


# ------------------------------------------------------------------ relay (smarthost)

def relay_status():
    r = load_settings().get("relay") or {}
    return {"enabled": bool(r.get("host")), "host": r.get("host", ""), "port": r.get("port", 587),
            "user": r.get("user", ""), "spf": r.get("spf", "")}


def normalize_spf(spf):
    terms = (spf or "").strip().lower().split()
    for t in terms:
        if not SPF_TERM_RE.match(t):
            raise Fail(f"invalid SPF entry '{t}' (use e.g. include:spf.brevo.com)")
    return " ".join(terms)


def relay_set(host, port=587, user="", spf=""):
    host = (host or "").strip().lower()
    if not HOST_RE.match(host):
        raise Fail(f"invalid relay host: {host or '<none>'}")
    try:
        port = int(port)
    except (TypeError, ValueError):
        raise Fail("port must be a number")
    if port not in (25, 465, 587, 2525):
        raise Fail("port must be 25, 465, 587 or 2525")
    user = (user or "").strip()
    if user and not re.fullmatch(r"[^\s:]{1,200}", user):
        raise Fail("invalid relay user name")
    spf = normalize_spf(spf)
    params = [f"relayhost = [{host}]:{port}",
              "smtp_tls_security_level = encrypt",
              f"smtp_tls_wrappermode = {'yes' if port == 465 else 'no'}"]
    if user:
        pw = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else getpass.getpass("Relay password: ")
        if not pw:
            raise Fail("the relay password is empty")
        fd = os.open(SASL_PASSWD + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(f"[{host}]:{port} {user}:{pw}\n")
        os.replace(SASL_PASSWD + ".tmp", SASL_PASSWD)
        run(["postmap", f"hash:{SASL_PASSWD}"])
        os.chmod(SASL_PASSWD + ".db", 0o600)
        params += ["smtp_sasl_auth_enable = yes",
                   f"smtp_sasl_password_maps = hash:{SASL_PASSWD}",
                   "smtp_sasl_security_options = noanonymous",
                   "smtp_sasl_tls_security_options = noanonymous"]
    else:
        run(["postconf", "-X", "smtp_sasl_auth_enable", "smtp_sasl_password_maps"], check=False)
    run(["postconf", "-e"] + params)
    run(["postfix", "reload"], check=False)
    s = load_settings()
    s["relay"] = {"host": host, "port": port, "user": user, "spf": spf}
    save_settings(s)
    audit(f"relay set {host}:{port} user={user or '-'}")
    info(f"outgoing mail now goes through {host}:{port}")
    return relay_status()


def direct_tls_level():
    """Outgoing TLS without a relay: DANE when install.sh found that the
    resolver checks DNSSEC (it then sets smtp_dns_support_level), else
    opportunistic."""
    dns = run(["postconf", "-h", "smtp_dns_support_level"], check=False).stdout.strip()
    return "dane" if dns == "dnssec" else "may"


def relay_off():
    run(["postconf", "-X", "relayhost", "smtp_sasl_auth_enable", "smtp_sasl_password_maps",
         "smtp_sasl_security_options", "smtp_sasl_tls_security_options", "smtp_tls_wrappermode"],
        check=False)
    run(["postconf", "-e", f"smtp_tls_security_level = {direct_tls_level()}"])
    for f in (SASL_PASSWD, SASL_PASSWD + ".db"):
        if os.path.exists(f):
            os.remove(f)
    run(["postfix", "reload"], check=False)
    s = load_settings()
    s.pop("relay", None)
    save_settings(s)
    audit("relay off")
    info("outgoing mail is delivered directly again")
    return relay_status()


def relay_test():
    """Connect to the relay and log in, without sending anything."""
    import smtplib
    import ssl as _ssl
    r = relay_status()
    if not r["enabled"]:
        raise Fail("no relay is configured")
    pw = None
    try:
        with open(SASL_PASSWD) as f:
            pw = f.read().split(None, 1)[1].strip().split(":", 1)[1]
    except (OSError, IndexError):
        pass
    ctx = _ssl.create_default_context()
    try:
        if r["port"] == 465:
            s = smtplib.SMTP_SSL(r["host"], 465, timeout=20, context=ctx)
        else:
            s = smtplib.SMTP(r["host"], r["port"], timeout=20)
            s.ehlo()
            s.starttls(context=ctx)
            s.ehlo()
        if r["user"]:
            s.login(r["user"], pw or "")
        s.quit()
    except (OSError, smtplib.SMTPException) as e:
        raise Fail(f"relay test failed: {e}")
    info(f"connected to {r['host']}:{r['port']} and logged in")
    return {"ok": True}


# ------------------------------------------------------------------ outgoing limit

def limit_status():
    return {"per_hour": int(load_settings().get("outgoing_limit", 0) or 0)}


def limit_set(n):
    try:
        n = int(n)
    except (TypeError, ValueError):
        raise Fail("the limit must be a number (0 = no limit)")
    if n < 0 or n > 100000:
        raise Fail("the limit must be between 0 and 100000")
    text = "# Managed by mailctl: messages each user may send per hour (0 = no limit).\n"
    if n:
        text += ("rates {\n  user = {\n    bucket = {\n"
                 f"      burst = {n};\n      rate = \"{n} / 1h\";\n"
                 "    }\n  }\n}\n")
    write_file(RATELIMIT_CONF, text, mode=0o640, like=RATELIMIT_CONF if os.path.exists(RATELIMIT_CONF) else None)
    try:
        shutil.chown(RATELIMIT_CONF, "root", "_rspamd")
    except (LookupError, OSError):
        pass
    run(["systemctl", "reload", "rspamd"], check=False)
    s = load_settings()
    s["outgoing_limit"] = n
    save_settings(s)
    audit(f"limit set {n}/h")
    info(f"outgoing limit: {n} messages per user per hour" if n else "outgoing limit removed")
    return limit_status()


# ------------------------------------------------------------------ forwarding & vacation

def user_home(email):
    return os.path.join(VMAIL_DIR, domain_of(email), email.split("@")[0])


def sieve_str(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def rules_get(email):
    email = lower_email(email)
    if not find_user(read_users(), email):
        raise Fail(f"no such mailbox: {email}")
    r = read_json(os.path.join(user_home(email), "dashboard-rules.json"), {})
    return {"email": email, "forward": r.get("forward"), "vacation": r.get("vacation")}


def rules_save(email, forward, vacation):
    home = user_home(email)
    os.makedirs(home, exist_ok=True)
    shutil.chown(home, "vmail", "vmail")
    rules = {"forward": forward, "vacation": vacation}
    path = os.path.join(home, "dashboard-rules.json")
    write_file(path, json.dumps(rules, indent=2) + "\n", mode=0o600)
    shutil.chown(path, "vmail", "vmail")
    sieve = os.path.join(home, "dashboard.sieve")
    for old in (sieve, sieve[:-6] + ".svbin"):
        if os.path.exists(old):
            os.remove(old)
    if not forward and not vacation:
        return
    need = {"copy"} if forward and forward.get("keep") else set()
    body = []
    if vacation:
        need |= {"vacation"}
        cond = []
        if vacation.get("start"):
            cond.append(f'currentdate :value "ge" "date" {sieve_str(vacation["start"])}')
        if vacation.get("end"):
            cond.append(f'currentdate :value "le" "date" {sieve_str(vacation["end"])}')
        if cond:
            need |= {"date", "relational"}
        addrs = [email] + [a["alias"] for a in alias_list()
                           if email in a["destinations"] and not a["alias"].startswith("@")]
        stmt = (f"vacation :days 3 :subject {sieve_str(vacation.get('subject') or 'Out of office')} "
                f":addresses [{', '.join(sieve_str(a) for a in addrs)}] {sieve_str(vacation['message'])};")
        body.append(f"  if allof({', '.join(cond)}) {{\n    {stmt}\n  }}" if cond else f"  {stmt}")
    if forward:
        cp = ":copy " if forward.get("keep") else ""
        body += [f"  redirect {cp}{sieve_str(t)};" for t in forward["to"]]
    text = ("# Managed by the mail dashboard (mailctl user forward / vacation). Do not edit.\n"
            f"require [{', '.join(sieve_str(x) for x in sorted(need))}];\n\n"
            "# Never forward or auto-reply to spam.\n"
            'if not header :contains "X-Spam" "Yes" {\n' + "\n".join(body) + "\n}\n")
    write_file(sieve, text, mode=0o600)
    shutil.chown(sieve, "vmail", "vmail")
    p = run(["runuser", "-u", "vmail", "--", "sievec", sieve], check=False)
    if p.returncode != 0:
        os.remove(sieve)
        raise Fail(f"could not build the filter: {(p.stderr or p.stdout).strip()[:200]}")


def user_forward(email, to=None, keep=True, off=False):
    r = rules_get(email)
    email = r["email"]
    if off:
        fwd = None
    else:
        targets = [lower_email(t, "forwarding address") for t in re.split(r"[,\s]+", to or "") if t]
        targets = list(dict.fromkeys(targets))
        if not targets:
            raise Fail("give at least one address to forward to")
        if len(targets) > 4:
            raise Fail("at most 4 forwarding addresses")
        if email in targets:
            raise Fail("a mailbox cannot forward to itself")
        fwd = {"to": targets, "keep": bool(keep)}
    rules_save(email, fwd, r["vacation"])
    audit(f"user forward {email} " + ("off" if off else f"-> {','.join(fwd['to'])} keep={fwd['keep']}"))
    info(f"forwarding for {email}: " + ("off" if off else ", ".join(fwd["to"])))
    return rules_get(email)


def user_vacation(email, subject="", start="", end="", off=False):
    r = rules_get(email)
    email = r["email"]
    if off:
        vac = None
    else:
        message = sys.stdin.read() if not sys.stdin.isatty() else input("Message: ")
        message = message.strip()
        if not message:
            raise Fail("the vacation message is empty")
        if len(message) > 5000 or len(subject or "") > 200:
            raise Fail("the vacation message or subject is too long")
        for d in (start, end):
            if d and not DATE_RE.match(d):
                raise Fail(f"invalid date '{d}' (use YYYY-MM-DD)")
        if start and end and end < start:
            raise Fail("the end date is before the start date")
        vac = {"subject": (subject or "Out of office").strip(), "message": message,
               "start": start or "", "end": end or ""}
    rules_save(email, r["forward"], vac)
    audit(f"user vacation {email} " + ("off" if off else f"{start or '-'}..{end or '-'}"))
    info(f"vacation reply for {email}: " + ("off" if off else "on"))
    return rules_get(email)


# ------------------------------------------------------------------ throwaway addresses

def temp_load():
    return read_json(TEMP_FILE, {})


def temp_add(owner, days=None, note=""):
    import secrets as _secrets
    owner = lower_email(owner)
    if not find_user(read_users(), owner):
        raise Fail(f"no such mailbox: {owner}")
    data = temp_load()
    if sum(1 for v in data.values() if v["owner"] == owner) >= 50:
        raise Fail("at most 50 throwaway addresses per mailbox")
    expires = None
    if days not in (None, "", "0", 0):
        try:
            d = int(days)
        except ValueError:
            raise Fail("days must be a number")
        if not 1 <= d <= 3650:
            raise Fail("days must be between 1 and 3650")
        expires = (datetime.datetime.now() + datetime.timedelta(days=d)).isoformat(timespec="seconds")
    existing = map_keys(VALIASES) | {u["email"] for u in read_users()}
    alphabet = "abcdefghijkmnpqrstuvwxyz23456789"
    while True:
        alias = "".join(_secrets.choice(alphabet) for _ in range(10)) + "@" + domain_of(owner)
        if alias not in existing:
            break
    alias_add(alias, owner)
    data[alias] = {"owner": owner, "created": datetime.datetime.now().isoformat(timespec="seconds"),
                   "expires": expires, "note": (note or "")[:100]}
    write_json(TEMP_FILE, data, group="mail-dashboard")
    info(f"throwaway address {alias} -> {owner}" + (f" (until {expires[:10]})" if expires else ""))
    return dict(data[alias], alias=alias)


def temp_list(owner=None):
    out = [dict(v, alias=k) for k, v in temp_load().items() if not owner or v["owner"] == owner]
    return sorted(out, key=lambda x: x["created"], reverse=True)


def temp_del(alias, owner=None):
    alias = (alias or "").strip().lower()
    data = temp_load()
    if alias not in data or (owner and data[alias]["owner"] != owner.lower()):
        raise Fail(f"no such throwaway address: {alias}")
    if alias in map_keys(VALIASES):
        alias_del(alias)
    data.pop(alias, None)
    write_json(TEMP_FILE, data, group="mail-dashboard")
    return {"alias": alias}


def temp_expire():
    now = datetime.datetime.now().isoformat(timespec="seconds")
    gone = [k for k, v in temp_load().items() if v.get("expires") and v["expires"] < now]
    for alias in gone:
        temp_del(alias)
    return {"expired": gone}


# ------------------------------------------------------------------ shared mailboxes

SHARE_RIGHTS = ["lookup", "read", "write", "write-seen", "write-deleted", "insert", "post",
                "expunge", "create"]


def shares_load():
    return read_json(SHARES_FILE, {})


def mailbox_folders(email):
    p = run(["doveadm", "mailbox", "list", "-u", email], check=False)
    return [x.strip() for x in p.stdout.splitlines() if x.strip() and not x.startswith("Shared")]


def share_apply(mailbox, member, grant=True):
    for folder in mailbox_folders(mailbox):
        if grant:
            run(["doveadm", "acl", "set", "-u", mailbox, folder, f"user={member}"] + SHARE_RIGHTS, check=False)
        else:
            run(["doveadm", "acl", "delete", "-u", mailbox, folder, f"user={member}"], check=False)
    run(["doveadm", "acl", "recalc", "-u", mailbox], check=False)


def share_add(mailbox, member):
    mailbox, member = lower_email(mailbox), lower_email(member)
    users = read_users()
    for e in (mailbox, member):
        if not find_user(users, e):
            raise Fail(f"no such mailbox: {e}")
    if mailbox == member:
        raise Fail("a mailbox is always shared with itself")
    data = shares_load()
    members = data.setdefault(mailbox, [])
    if member not in members:
        members.append(member)
    share_apply(mailbox, member, True)
    write_json(SHARES_FILE, data, group="mail-dashboard")
    postmap_all()
    audit(f"share {mailbox} with {member}")
    info(f"{member} can now read {mailbox} (Shared/{mailbox}/ in their mail app) and send as it")
    return {"mailbox": mailbox, "members": members}


def share_del(mailbox, member):
    mailbox, member = lower_email(mailbox), lower_email(member)
    data = shares_load()
    if member not in data.get(mailbox, []):
        raise Fail(f"{mailbox} is not shared with {member}")
    data[mailbox].remove(member)
    if not data[mailbox]:
        del data[mailbox]
    share_apply(mailbox, member, False)
    write_json(SHARES_FILE, data, group="mail-dashboard")
    postmap_all()
    audit(f"unshare {mailbox} from {member}")
    info(f"{member} no longer has access to {mailbox}")
    return {"mailbox": mailbox, "members": data.get(mailbox, [])}


def share_sync():
    """Re-apply sharing to folders created since (run nightly)."""
    for mailbox, members in shares_load().items():
        for m in members:
            share_apply(mailbox, m, True)
    return shares_load()


def forget_user(email):
    """Remove a deleted mailbox from shares and throwaway addresses."""
    data = shares_load()
    changed = False
    for mb in list(data):
        if mb == email:
            del data[mb]
            changed = True
        elif email in data[mb]:
            data[mb].remove(email)
            changed = True
            if not data[mb]:
                del data[mb]
    if changed:
        write_json(SHARES_FILE, data, group="mail-dashboard")
    for alias in [k for k, v in temp_load().items() if v["owner"] == email]:
        temp_del(alias)
    apppw_clear(email, forget=True)


# ------------------------------------------------------------------ Junk quarantine & search

def junk_list(user=None, days=30, limit=300):
    users = [lower_email(user)] if user else [u["email"] for u in read_users()]
    since = (datetime.date.today() - datetime.timedelta(days=int(days))).isoformat()
    out = []
    for u in users:
        p = run(["doveadm", "-f", "json", "fetch", "-u", u,
                 "uid date.received size.virtual hdr.from hdr.subject",
                 "mailbox", "Junk", "SINCE", since], check=False, timeout=120)
        try:
            rows = json.loads(p.stdout or "[]")
        except ValueError:
            rows = []
        for r in rows:
            out.append({"user": u, "id": r.get("uid"), "date": r.get("date.received"),
                        "size": int(r.get("size.virtual") or 0),
                        "from": (r.get("hdr.from") or "").strip()[:200],
                        "subject": (r.get("hdr.subject") or "").strip()[:200]})
    out.sort(key=lambda x: x["date"] or "", reverse=True)
    return out[:int(limit)]


def junk_action(action, user, uid):
    """uid: the message's number in the user's Junk folder."""
    user = lower_email(user)
    if not UID_RE.match(str(uid or "")):
        raise Fail("invalid message id")
    if not find_user(read_users(), user):
        raise Fail(f"no such mailbox: {user}")
    if action == "release":
        # Teach the spam filter that this was not spam, then move it to INBOX.
        p = subprocess.run(["doveadm", "fetch", "-u", user, "text", "mailbox", "Junk", "uid", str(uid)],
                           capture_output=True, timeout=60)
        raw = p.stdout
        if raw.startswith(b"text:"):
            raw = raw[5:].lstrip(b"\n")
        if raw.strip():
            subprocess.run(["rspamc", "-h", "127.0.0.1:11334", "learn_ham"], input=raw,
                           capture_output=True, timeout=60)
        run(["doveadm", "move", "-u", user, "INBOX", "mailbox", "Junk", "uid", str(uid)])
    elif action == "delete":
        run(["doveadm", "expunge", "-u", user, "mailbox", "Junk", "uid", str(uid)])
    else:
        raise Fail(f"unknown action: {action}")
    audit(f"junk {action} {user} {uid}")
    info("message " + ("moved to INBOX" if action == "release" else "deleted"))
    return {"action": action, "user": user, "id": uid}


def search_rebuild(user=None):
    target = ["-u", lower_email(user)] if user else ["-A"]
    run(["doveadm", "fts", "rescan"] + target, check=False, timeout=600)
    run(["doveadm", "index"] + target + ["-q", "*"], check=False, timeout=600)
    audit("search rebuild " + (user or "all"))
    info("search index rebuild queued")
    return {"queued": True}


# ------------------------------------------------------------------ app passwords

APP_PW_FILE = "/etc/mail-server/app-passwords.json"
APP_PW_DIR = "/etc/dovecot/app-passwords"
APP_PW_MAX = 20
APP_PW_ALPHABET = "abcdefghijkmnpqrstuvwxyz23456789"


def apppw_load():
    return read_json(APP_PW_FILE, {})


def apppw_required():
    """Mailboxes whose mail apps must use app passwords."""
    return {e for e, v in apppw_load().items() if v.get("required")}


def apppw_write(data):
    """Save the list and rebuild Dovecot's copy.

    Dovecot keys a passwd-file by user name, so one file cannot hold several
    passwords for the same mailbox. Instead each app password gets its own
    file, named after the password's SHA-256: Dovecot hashes what the mail app
    sent to find the file (see the app-passwords passdb in dovecot.conf).
    The passwords are random, so an unsalted hash is safe.
    """
    write_json(APP_PW_FILE, data, mode=0o600)
    os.makedirs(APP_PW_DIR, exist_ok=True)
    try:
        shutil.chown(APP_PW_DIR, "root", "dovecot")
    except (LookupError, OSError):
        pass
    os.chmod(APP_PW_DIR, 0o750)
    want = {p["hash"]: f"{email}:{{SHA256.HEX}}{p['hash']}::::::\n"
            for email, v in data.items() for p in v.get("passwords", [])}
    for name in os.listdir(APP_PW_DIR):
        if name not in want:
            os.remove(os.path.join(APP_PW_DIR, name))
    for h, line in want.items():
        path = os.path.join(APP_PW_DIR, h)
        write_file(path, line, mode=0o640)
        try:
            shutil.chown(path, "root", "dovecot")
        except (LookupError, OSError):
            pass


def apppw_entry(data, email):
    email = lower_email(email)
    if not find_user(read_users(), email):
        raise Fail(f"no such mailbox: {email}")
    return email, data.setdefault(email, {"required": False, "passwords": []})


def apppw_add(email, name=""):
    import secrets as _secrets
    data = apppw_load()
    email, entry = apppw_entry(data, email)
    name = re.sub(r"\s+", " ", name or "").strip()[:40] or "Mail app"
    if not name.isprintable():
        raise Fail("invalid name")
    if len(entry["passwords"]) >= APP_PW_MAX:
        raise Fail(f"at most {APP_PW_MAX} app passwords per mailbox; delete one first")
    pw = "-".join("".join(_secrets.choice(APP_PW_ALPHABET) for _ in range(4)) for _ in range(4))
    item = {"id": _secrets.token_hex(4), "name": name,
            "created": datetime.datetime.now().isoformat(timespec="seconds"),
            "hash": hashlib.sha256(pw.encode()).hexdigest()}
    entry["passwords"].append(item)
    apppw_write(data)
    audit(f"apppass add {email} {item['id']} ({name})")
    info(f"app password for {email} ({name}): {pw}")
    return {"email": email, "id": item["id"], "name": name, "created": item["created"], "password": pw}


def apppw_list(email):
    email, entry = apppw_entry(apppw_load(), email)
    return {"email": email, "required": bool(entry.get("required")),
            "passwords": [{k: p[k] for k in ("id", "name", "created")} for p in entry["passwords"]]}


def apppw_del(email, pid):
    data = apppw_load()
    email, entry = apppw_entry(data, email)
    kept = [p for p in entry["passwords"] if p["id"] != pid]
    if len(kept) == len(entry["passwords"]):
        raise Fail(f"no such app password: {pid or '<none>'}")
    entry["passwords"] = kept
    if not kept and not entry.get("required"):
        del data[email]
    apppw_write(data)
    audit(f"apppass del {email} {pid}")
    info("app password deleted")
    return apppw_list(email)


def apppw_require(email, on):
    if on not in ("yes", "no"):
        raise Fail("use: mailctl user apppass require <email> yes|no")
    data = apppw_load()
    email, entry = apppw_entry(data, email)
    entry["required"] = on == "yes"
    if not entry["required"] and not entry["passwords"]:
        del data[email]
    apppw_write(data)
    write_users(read_users())   # adds or removes the mailbox's allow_nets
    audit(f"apppass require {email} {on}")
    info(f"mail apps for {email} " + ("must now use app passwords" if on == "yes"
                                      else "may use the mailbox password again"))
    return apppw_list(email)


def apppw_clear(email, forget=False):
    """Revoke a mailbox's app passwords (forget=True also drops its setting)."""
    data = apppw_load()
    entry = data.get(email)
    if not entry:
        return 0
    n = len(entry.get("passwords", []))
    entry["passwords"] = []
    if forget or not entry.get("required"):
        del data[email]
    apppw_write(data)
    return n


def user_checkpw(email, apps=False):
    """Check a password read from stdin, for the dashboard's sign-in (the
    mailbox password only) and for calendars and contacts (apps=True: app
    passwords too, and only those once the mailbox requires them)."""
    pw = sys.stdin.readline().rstrip("\n")
    email = (email or "").strip().lower()
    u = find_user(read_users(), email) if EMAIL_RE.match(email) else None
    if not u or not pw:
        return {"ok": False}
    entry = apppw_load().get(email, {})
    if apps:
        h = hashlib.sha256(pw.encode()).hexdigest()
        if any(hmac.compare_digest(h, p["hash"]) for p in entry.get("passwords", [])):
            return {"ok": True, "via": "app password"}
        if entry.get("required"):
            return {"ok": False}
    ok = verify_password(pw, u["hash"])
    return {"ok": ok, "via": "password"} if ok else {"ok": False}


# ------------------------------------------------------------------ importing mail

IMPORT_DIR = "/var/lib/mail-server/imports"
IMPORT_RUN_DIR = "/run/mail-server"
# Not copied: Gmail's "All Mail" and "Starred" repeat mail from other folders,
# and nobody wants the old spam and trash.
IMPORT_SKIP = ("\\All", "\\Flagged", "\\Junk", "\\Trash")
# Folders that arrive under the old server's name are merged into ours.
IMPORT_MERGE = {"\\Sent": "Sent", "\\Drafts": "Drafts", "\\Archive": "Archive"}


def import_paths(email):
    """State, log, Dovecot config (holds the old password) and unit prefix."""
    key = hashlib.sha256(email.encode()).hexdigest()[:16]
    return (os.path.join(IMPORT_DIR, f"{key}.json"), os.path.join(IMPORT_DIR, f"{key}.log"),
            os.path.join(IMPORT_RUN_DIR, f"import-{key}.conf"), f"mail-import-{key}")


def import_check_host(host, allow_private):
    try:
        addrs = {ipaddress.ip_address(a[4][0]) for a in socket.getaddrinfo(host, None)}
    except (OSError, ValueError):
        raise Fail(f"{host} does not resolve; check the server name")
    own = {C.get("SERVER_IPV4"), C.get("SERVER_IPV6")} - {None, ""}
    for ip in addrs:
        if str(ip) in own:
            raise Fail(f"{host} is this server; enter the old provider's IMAP server")
        if not ip.is_global and not allow_private:
            raise Fail(f"{host} points to a private address ({ip}); only servers on the internet can be imported from")


def import_probe(host, port, security, user, pw):
    """Log in to the old server and list its folders: [(name, flags, delimiter)]."""
    import imaplib
    import ssl as _ssl
    ctx = _ssl.create_default_context()
    # Accept what Dovecot will accept (OpenSSL's defaults). Python 3.13+ adds
    # extra certificate rules; chain and host name are still verified.
    ctx.verify_flags &= ~getattr(_ssl, "VERIFY_X509_STRICT", 0)
    try:
        if security == "ssl":
            m = imaplib.IMAP4_SSL(host, port, ssl_context=ctx, timeout=30)
        else:
            m = imaplib.IMAP4(host, port, timeout=30)
            m.starttls(ssl_context=ctx)
        try:
            m.login(user, pw)
        except imaplib.IMAP4.error as e:
            why = e.args[0] if e.args else ""
            why = why.decode(errors="replace") if isinstance(why, bytes) else str(why)
            raise Fail(f"the old server refused the login: {why}"
                       " (Gmail, Yahoo and iCloud need an app password from your account settings)")
        typ, rows = m.list()
        try:
            m.logout()
        except (OSError, imaplib.IMAP4.error):
            pass
    except UnicodeEncodeError:
        raise Fail("the user name and password must be plain ASCII characters")
    except (OSError, imaplib.IMAP4.error) as e:
        raise Fail(f"could not connect to {host}:{port} ({security}): {e}")
    folders = []
    for r in rows or []:
        if not isinstance(r, bytes):
            continue          # a literal: a name this simple parser does not handle
        m = re.match(r'^\((?P<flags>[^)]*)\) (?P<delim>"(?:[^"\\]|\\.)*"|NIL) (?P<name>.+)$',
                     r.decode(errors="replace"))
        if not m:
            continue
        name = m.group("name")
        if name.startswith('"'):
            name = re.sub(r"\\(.)", r"\1", name[1:-1])
        delim = m.group("delim")
        delim = "" if delim == "NIL" else re.sub(r"\\(.)", r"\1", delim[1:-1])
        folders.append((name, m.group("flags").split(), delim))
    return folders


def import_plan(folders):
    """What to leave out, and which folders to merge into ours afterwards."""
    skip = list(IMPORT_SKIP)
    merges = []
    for name, flags, delim in folders:
        local = name.replace(delim, "/") if delim and delim != "/" else name
        if "\\Important" in flags and "&" not in name:
            skip.append(local)              # Gmail's "Important" label
        for flag, ours in IMPORT_MERGE.items():
            if flag in flags and local != ours:
                merges.append([local, ours])
    return skip, merges


def import_conf(host, port, security, user, pw):
    """A Dovecot config for the import: the server's own plus the old server."""
    main = "/etc/dovecot/dovecot.conf"
    with open(main) as f:
        v = re.search(r"^\s*dovecot_config_version\s*=\s*(\S+)", f.read(), re.M)
    q = lambda s: '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
    lines = [f"dovecot_config_version = {v.group(1)}"] if v else []   # 2.4 wants it first
    lines += [f"!include {main}",
              f"imapc_host = {q(host)}", f"imapc_port = {port}",
              f"imapc_user = {q(user)}", f"imapc_password = {q(pw)}",
              f"imapc_ssl = {'imaps' if security == 'ssl' else 'starttls'}",
              "ssl_client_ca_dir = /etc/ssl/certs",
              "ssl_client_require_valid_cert = yes" if v else "imapc_ssl_verify = yes"]
    return "\n".join(lines) + "\n"


def mailbox_messages(email, mailbox=None):
    p = run(["doveadm", "-f", "tab", "mailbox", "status", "-u", email, "messages", mailbox or "*"],
            check=False, timeout=300)
    return sum(int(x) for x in p.stdout.split()[1:] if x.isdigit())


def unit_active(unit):
    if not unit:
        return False
    return run(["systemctl", "is-active", unit], check=False).stdout.strip() in ("active", "activating")


def import_start(email, host, port=None, security="ssl", user="", allow_private=False):
    email = lower_email(email)
    if not find_user(read_users(), email):
        raise Fail(f"no such mailbox: {email}")
    host = (host or "").strip().lower().rstrip(".")
    if not HOST_RE.match(host):
        raise Fail(f"invalid server name: {host or '<none>'} (e.g. imap.gmail.com)")
    security = (security or "ssl").lower()
    if security not in ("ssl", "starttls"):
        raise Fail("security must be ssl (port 993) or starttls (port 143)")
    try:
        port = int(port or (993 if security == "ssl" else 143))
    except ValueError:
        raise Fail("port must be a number")
    if not allow_private and port not in (143, 993):
        raise Fail("port must be 993 (SSL/TLS) or 143 (STARTTLS)")
    user = (user or "").strip()
    # Dovecot would expand %-variables in the user name.
    if not user or len(user) > 200 or not user.isprintable() or "%" in user:
        raise Fail("invalid user name for the old server")
    pw = sys.stdin.readline().rstrip("\n") if not sys.stdin.isatty() else getpass.getpass("Password on the old server: ")
    if not pw or not pw.isprintable():
        raise Fail("the password for the old server is empty or contains control characters")
    if "%{" in pw and dovecot_version() >= (2, 4):
        # Dovecot 2.4 expands %{...} in imapc_password, and there is no
        # escaping that works for every password.
        raise Fail("passwords containing '%{' cannot be imported; change it on the old server for the import")
    state_file, log_file, conf_file, unit = import_paths(email)
    st = read_json(state_file, {})
    if st.get("status") == "running" and unit_active(st.get("unit")):
        raise Fail(f"an import into {email} is already running")
    import_check_host(host, allow_private)
    folders = import_probe(host, port, security, user, pw)
    skip, merges = import_plan(folders)
    for d in (IMPORT_DIR, IMPORT_RUN_DIR):
        os.makedirs(d, mode=0o700, exist_ok=True)
    fd = os.open(conf_file + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(import_conf(host, port, security, user, pw))
    os.replace(conf_file + ".tmp", conf_file)
    unit = f"{unit}-{int(time.time())}"
    st = {"email": email, "host": host, "port": port, "security": security, "user": user,
          "status": "running", "started": datetime.datetime.now().isoformat(timespec="seconds"),
          "finished": None, "folders": len(folders), "skip": skip, "merges": merges, "unit": unit,
          "before": mailbox_messages(email), "imported": None, "message": ""}
    write_json(state_file, st, mode=0o600)
    with open(log_file, "w"):
        pass
    # Low priority, in its own unit: a big mailbox takes hours and must not
    # stop when the dashboard request that started it ends.
    p = run(["systemd-run", "--unit", unit, "--collect", "--quiet", "-p", "Nice=10",
             "-p", "IOSchedulingClass=idle", "/usr/local/sbin/mailctl", "user", "import", "run", email],
            check=False)
    if p.returncode != 0:
        os.remove(conf_file)
        st.update(status="failed", message=f"could not start: {(p.stderr or p.stdout).strip()[:200]}")
        write_json(state_file, st, mode=0o600)
        raise Fail(st["message"])
    audit(f"import start {email} from {user}@{host}:{port}")
    info(f"importing mail from {user} at {host} into {email} in the background "
         f"(mailctl user import status {email})")
    return import_status(email)


def import_merge(email, src, dst):
    """Move an imported folder's messages (e.g. Gmail's "[Gmail]/Sent Mail")
    into ours ("Sent"). Messages already there are dropped, so running the
    import again does not duplicate them."""
    def rows(mailbox):
        p = run(["doveadm", "-f", "json", "fetch", "-u", email, "uid hdr.message-id",
                 "mailbox", mailbox, "all"], check=False, timeout=900)
        try:
            return json.loads(p.stdout or "[]") if p.returncode == 0 else None
        except ValueError:
            return None
    src_rows = rows(src)
    if src_rows is None:
        return 0
    run(["doveadm", "mailbox", "create", "-s", "-u", email, dst], check=False)
    have = {(r.get("hdr.message-id") or "").strip() for r in rows(dst) or []} - {""}
    move, dup = [], []
    for r in src_rows:
        mid = (r.get("hdr.message-id") or "").strip()
        (dup if mid and mid in have else move).append(str(r["uid"]))
        have.add(mid)
    for i in range(0, len(move), 500):
        run(["doveadm", "move", "-u", email, dst, "mailbox", src, "uid", ",".join(move[i:i + 500])],
            check=False, timeout=900)
    for i in range(0, len(dup), 500):
        run(["doveadm", "expunge", "-u", email, "mailbox", src, "uid", ",".join(dup[i:i + 500])],
            check=False, timeout=900)
    return len(move)


def mailbox_delete_if_empty(email, mailbox):
    children = run(["doveadm", "mailbox", "list", "-u", email, f"{mailbox}/*"], check=False).stdout.strip()
    if not children and mailbox_messages(email, mailbox) == 0:
        run(["doveadm", "mailbox", "delete", "-u", email, mailbox], check=False)


def import_run(email):
    """The background part of "user import start" (runs in its own unit)."""
    email = lower_email(email)
    state_file, log_file, conf_file, _ = import_paths(email)
    st = read_json(state_file, None)
    if not st or st.get("status") != "running" or not os.path.exists(conf_file):
        raise Fail(f"no import is waiting to run for {email}")
    # One-way sync from the old server: adds what is missing here, never
    # deletes anything on either side, and can safely run again later.
    cmd = ["doveadm", "-c", conf_file, "sync", "-1", "-R"]
    for x in st["skip"]:
        cmd += ["-x", x]
    cmd += ["-u", email, "imapc:"]
    rc = 1
    try:
        for _ in range(3):       # exit code 2: changes during the sync, run again
            with open(log_file, "a") as log:
                rc = subprocess.run(cmd, stdout=log, stderr=subprocess.STDOUT,
                                    stdin=subprocess.DEVNULL).returncode
            if rc != 2:
                break
    finally:
        os.remove(conf_file)     # it holds the old server's password
    for src, dst in st["merges"]:
        import_merge(email, src, dst)
        mailbox_delete_if_empty(email, src)
        if "/" in src:
            mailbox_delete_if_empty(email, src.rsplit("/", 1)[0])
    errors = [line for line in import_log(log_file, 200) if "Error:" in line or "Fatal:" in line]
    st.update(status="done" if rc == 0 else "failed",
              finished=datetime.datetime.now().isoformat(timespec="seconds"),
              imported=max(0, mailbox_messages(email) - (st.get("before") or 0)),
              message=re.sub(r"^.*?(Error|Fatal): ", "", errors[-1])[:300] if errors and rc != 0 else "")
    write_json(state_file, st, mode=0o600)
    audit(f"import {st['status']} {email}: {st['imported']} message(s) from {st['host']}")
    return st


def import_log(path, lines=15):
    try:
        with open(path, errors="replace") as f:
            return [x.rstrip("\n") for x in f.readlines()[-lines:]]
    except OSError:
        return []


def import_status(email):
    email = lower_email(email)
    state_file, log_file, conf_file, _ = import_paths(email)
    st = read_json(state_file, None)
    if not st:
        return {"email": email, "status": "none"}
    if st["status"] == "running" and not unit_active(st.get("unit")):
        time.sleep(1)            # the unit may be writing its result right now
        st = read_json(state_file, st)
        if st["status"] == "running":
            st.update(status="failed", message="the import stopped unexpectedly (server restart?)",
                      finished=datetime.datetime.now().isoformat(timespec="seconds"))
            write_json(state_file, st, mode=0o600)
            if os.path.exists(conf_file):
                os.remove(conf_file)
    st["log"] = [x for x in import_log(log_file) if " Info: " not in x]
    return st


def import_cancel(email):
    email = lower_email(email)
    state_file, _, conf_file, _ = import_paths(email)
    st = read_json(state_file, None)
    if not st or st.get("status") != "running":
        raise Fail(f"no import is running for {email}")
    run(["systemctl", "stop", st["unit"]], check=False, timeout=60)
    if os.path.exists(conf_file):
        os.remove(conf_file)
    st.update(status="cancelled", finished=datetime.datetime.now().isoformat(timespec="seconds"),
              message="stopped; mail copied so far was kept")
    write_json(state_file, st, mode=0o600)
    audit(f"import cancel {email}")
    info(f"import into {email} stopped")
    return import_status(email)


# ------------------------------------------------------------------ alerts & weekly report

ALERT_STATE = "/var/lib/mail-server/alerts.json"
ALERT_WARN_NAMES = {"TLS certificate", "disk space", "memory", "backups", "outgoing queue"}
REALERT_HOURS = 24


def alert_recipient():
    return (load_settings().get("alert_email") or C.get("LETSENCRYPT_EMAIL")
            or C.get("ADMIN_EMAIL"))


def alerts_config(email=None, weekly=None):
    s = load_settings()
    if email is not None:
        s["alert_email"] = lower_email(email, "alert address") if email else ""
    if weekly is not None:
        s["weekly_report"] = weekly in (True, "yes", "on", "1")
    save_settings(s)
    audit(f"alerts config email={s.get('alert_email') or 'default'} weekly={s.get('weekly_report', True)}")
    return alerts_status()


def alerts_status():
    s = load_settings()
    state = read_json(ALERT_STATE, {})
    return {"recipient": alert_recipient(), "custom": bool(s.get("alert_email")),
            "weekly_report": s.get("weekly_report", True),
            "open": [dict(v, key=k) for k, v in state.get("open", {}).items()],
            "last_run": state.get("last_run")}


def send_mail(to, subject, body):
    msg = (f"From: Mail server <postmaster@{C['DOMAIN']}>\n"
           f"To: {to}\n"
           f"Subject: [{C['MAIL_HOSTNAME']}] {subject}\n"
           "Content-Type: text/plain; charset=utf-8\n"
           "Auto-Submitted: auto-generated\n\n" + body)
    p = subprocess.run(["/usr/sbin/sendmail", "-t", "-oi", "-f", f"postmaster@{C['DOMAIN']}"],
                       input=msg.encode(), capture_output=True, timeout=60)
    if p.returncode != 0:
        raise Fail(f"could not send mail: {p.stderr.decode(errors='replace').strip()[:200]}")


def alertable(r):
    if r["status"] == "error":
        return True
    return r["status"] == "warn" and r["name"] in ALERT_WARN_NAMES


def ratelimit_hits(since_ts):
    """Users who hit the outgoing limit since since_ts (from the Rspamd log)."""
    hits = {}
    try:
        with open("/var/log/rspamd/rspamd.log", errors="replace") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 5_000_000))
            for line in f:
                if "RATELIMITED" not in line and "ratelimit" not in line.lower():
                    continue
                m = re.match(r"(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)", line)
                u = re.search(r"user: ([^,\s]+)", line)
                if not m or not u or "ratelimit" not in line.lower():
                    continue
                ts = datetime.datetime.strptime(m.group(1), "%Y-%m-%d %H:%M:%S").timestamp()
                if ts > since_ts and ("soft reject" in line or "RATELIMITED" in line):
                    hits[u.group(1)] = hits.get(u.group(1), 0) + 1
    except OSError:
        pass
    return hits


def alerts_run():
    state = read_json(ALERT_STATE, {})
    now = time.time()
    last = state.get("last_run_ts", now - 900)
    open_ = state.get("open", {})
    rows = checks(include_dns=True)
    current = {f"{r['group']}: {r['name']}": r for r in rows if alertable(r)}
    new, repeat = [], []
    for k, r in current.items():
        prev = open_.get(k)
        if not prev:
            new.append((k, r))
            open_[k] = {"since": now, "sent": now, "detail": r["detail"]}
        elif now - prev.get("sent", 0) > REALERT_HOURS * 3600:
            repeat.append((k, r))
            prev["sent"] = now
            prev["detail"] = r["detail"]
    resolved = [k for k in list(open_) if k not in current]
    for k in resolved:
        del open_[k]
    hits = ratelimit_hits(last)
    lines = []
    if new or repeat:
        lines.append("PROBLEMS\n")
        for k, r in new + repeat:
            lines.append(f"  ✗ {k}: {r['detail']}" + ("   (still failing)" if (k, r) in repeat else ""))
        lines.append("")
    if hits:
        lines.append("OUTGOING LIMIT REACHED - check these accounts; a stolen password is the usual cause\n")
        for u, n in sorted(hits.items()):
            lines.append(f"  ! {u}: {n} message(s) held back")
        lines.append("")
    if resolved:
        lines.append("RESOLVED\n")
        lines += [f"  ✓ {k}" for k in resolved]
        lines.append("")
    sent = False
    if lines:
        count = len(new) + len(repeat)
        subject = (f"{count} problem(s) need attention" if count else
                   "Outgoing limit reached" if hits else "All problems resolved")
        body = "\n".join(lines) + (f"\nDetails: https://{C['MAIL_HOSTNAME']}/admin/health\n"
                                   "Sent by the mail server's automatic checks (every 15 minutes).\n")
        try:
            send_mail(alert_recipient(), subject, body)
            sent = True
        except Fail as e:
            print(f"mailctl: {e}", file=sys.stderr)
    state.update(open=open_, last_run_ts=now,
                 last_run=datetime.datetime.now().isoformat(timespec="seconds"))
    os.makedirs(STATE_DIR, exist_ok=True)
    write_json(ALERT_STATE, state, mode=0o640)
    info(f"{len(current)} open problem(s), {len(new)} new, {len(resolved)} resolved"
         + (", alert sent" if sent else ""))
    return {"open": len(current), "new": len(new), "resolved": len(resolved), "sent": sent,
            "ratelimited": hits}


def alerts_test():
    send_mail(alert_recipient(), "Test alert",
              "This is a test of the mail server's alert emails. If you can read this, alerts work.\n")
    audit("alerts test")
    info(f"test alert sent to {alert_recipient()}")
    return {"sent_to": alert_recipient()}


def mail_stats(days=7):
    """Counts from the Postfix and Rspamd logs for the last N days."""
    since = f"{days} days ago"
    p = run(["journalctl", "--no-pager", "-o", "cat", "-u", "postfix@-.service", "--since", since],
            check=False, timeout=300)
    st = {"received": 0, "sent": 0, "bounced": 0, "rejected": 0}
    for line in p.stdout.splitlines():
        if "status=sent" in line:
            if "relay=" in line and "dovecot" in line:
                st["received"] += 1
            elif "postfix/smtp[" in line or "relay=[" in line:
                st["sent"] += 1
        elif "status=bounced" in line:
            st["bounced"] += 1
        elif "NOQUEUE: reject" in line or "milter-reject" in line:
            st["rejected"] += 1
    cutoff = (datetime.datetime.now() - datetime.timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
    junk = 0
    try:
        with open("/var/log/rspamd/rspamd.log", errors="replace") as f:
            for line in f:
                if line[:19] >= cutoff and "(add header)" in line:
                    junk += 1
    except OSError:
        pass
    st["to_junk"] = junk
    return st


def report_weekly(force=False):
    if not force and not load_settings().get("weekly_report", True):
        info("weekly report is switched off")
        return {"sent": False}
    st = mail_stats(7)
    rows = checks(include_dns=True)
    bad = [r for r in rows if r["status"] == "error"]
    users = sorted(user_list(), key=lambda u: u["used_bytes"] or 0, reverse=True)
    dm = dmarc_summary(7)
    lines = [f"Weekly report for {C['MAIL_HOSTNAME']}", "",
             "MAIL (last 7 days)",
             f"  received        {st['received']}",
             f"  sent out        {st['sent']}",
             f"  put in Junk     {st['to_junk']}",
             f"  refused         {st['rejected']}   (spam, unknown recipients, bots)",
             f"  bounced         {st['bounced']}", "",
             "HEALTH",
             ("  ✓ all checks pass" if not bad else
              "\n".join(f"  ✗ {r['group']}: {r['name']} - {r['detail']}" for r in bad)), "",
             "LARGEST MAILBOXES"]
    for u in users[:5]:
        q = f" of {u['quota']}" if u["quota"] else ""
        lines.append(f"  {u['email']:<40} {human_bytes(u['used_bytes'])}{q}")
    lines += ["", "DMARC (who sends mail as your domains)"]
    if not dm["domains"]:
        lines.append("  no DMARC reports received this week")
    for d in dm["domains"]:
        lines.append(f"  {d['domain']}: {d['messages']} messages reported, {d['failed']} failed checks"
                     + (f", {d['foreign_failed']} from other servers (possible spoofing)" if d["foreign_failed"] else ""))
    b = backup_list()
    lines += ["", "BACKUPS", f"  last backup: {b[0]['created'][:16].replace('T', ' ') if b else 'none'}",
              "", f"Dashboard: https://{C['MAIL_HOSTNAME']}/admin/", ""]
    send_mail(alert_recipient(), "Weekly report", "\n".join(lines))
    info(f"weekly report sent to {alert_recipient()}")
    return {"sent": True, "stats": st}


# ------------------------------------------------------------------ DMARC reports

DMARC_DIR = "/var/lib/mail-server/dmarc"


def dmarc_reports(days=30):
    cutoff = time.time() - int(days) * 86400
    out = []
    for f in glob.glob(os.path.join(DMARC_DIR, "*.json")):
        r = read_json(f, None)
        if r and r.get("end", 0) >= cutoff:
            out.append(r)
    return sorted(out, key=lambda r: r.get("end", 0), reverse=True)


def dmarc_summary(days=30):
    own = {C.get("SERVER_IPV4"), C.get("SERVER_IPV6")} - {None, ""}
    doms = {}
    for rep in dmarc_reports(days):
        d = doms.setdefault(rep.get("domain", "?"), {"domain": rep.get("domain", "?"), "reports": 0,
                                                     "messages": 0, "failed": 0, "foreign_failed": 0,
                                                     "sources": {}, "reporters": set()})
        d["reports"] += 1
        d["reporters"].add(rep.get("org", "?"))
        for rec in rep.get("records", []):
            n = int(rec.get("count", 0))
            ok = rec.get("dkim") == "pass" or rec.get("spf") == "pass"
            d["messages"] += n
            key = (rec.get("ip", "?"), rec.get("header_from", ""))
            s = d["sources"].setdefault(key, {"ip": key[0], "header_from": key[1], "messages": 0,
                                              "passed": 0, "failed": 0, "own": key[0] in own,
                                              "dispositions": {}})
            s["messages"] += n
            s["passed" if ok else "failed"] += n
            disp = rec.get("disposition", "none")
            s["dispositions"][disp] = s["dispositions"].get(disp, 0) + n
            if not ok:
                d["failed"] += n
                if key[0] not in own:
                    d["foreign_failed"] += n
    out = []
    for d in doms.values():
        d["reporters"] = sorted(d["reporters"])
        d["sources"] = sorted(d["sources"].values(), key=lambda s: (-s["failed"], -s["messages"]))
        out.append(d)
    return {"days": int(days), "domains": sorted(out, key=lambda d: d["domain"])}


# ------------------------------------------------------------------ DNS automation

DNS_API_FILE = "/etc/mail-server/dns-api.json"


class DnsApiError(Fail):
    pass


def _http(method, url, headers, body=None):
    import urllib.error
    import urllib.request
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method,
                                 headers=dict(headers, **{"Content-Type": "application/json"}))
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            txt = r.read().decode()
            return json.loads(txt) if txt else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")[:300]
        raise DnsApiError(f"DNS provider refused the request ({e.code}): {detail}")
    except (OSError, ValueError) as e:
        raise DnsApiError(f"could not reach the DNS provider: {e}")


def _norm_host(h):
    return (h or "").strip().rstrip(".").lower()


def _norm_txt(t):
    t = (t or "").strip()
    if t.startswith('"'):
        t = "".join(re.findall(r'"((?:[^"\\]|\\.)*)"', t))
    return t


class Cloudflare:
    name = "Cloudflare"

    def __init__(self, token):
        self.base = os.environ.get("MAILCTL_DNS_API_URL", "https://api.cloudflare.com/client/v4")
        self.h = {"Authorization": f"Bearer {token}"}

    def zone(self, domain):
        parts = domain.split(".")
        for i in range(len(parts) - 1):
            z = ".".join(parts[i:])
            r = _http("GET", f"{self.base}/zones?name={z}", self.h)
            if r.get("result"):
                return r["result"][0]["id"], z
        raise DnsApiError(f"{domain} is not in this Cloudflare account")

    def list(self, zone, fqdn, rtype):
        r = _http("GET", f"{self.base}/zones/{zone}/dns_records?type={rtype}&name={fqdn}&per_page=100", self.h)
        out = []
        for x in r.get("result", []):
            rec = {"id": x["id"], "type": x["type"], "fqdn": _norm_host(x["name"])}
            if x["type"] == "SRV":
                d = x.get("data") or {}
                rec["value"] = f"{d.get('priority')} {d.get('weight')} {d.get('port')} {_norm_host(d.get('target'))}"
            elif x["type"] == "MX":
                rec["value"] = f"{x.get('priority')} {_norm_host(x['content'])}"
            elif x["type"] == "TXT":
                rec["value"] = _norm_txt(x["content"])
            else:
                rec["value"] = _norm_host(x["content"])
            out.append(rec)
        return out

    def _body(self, rec):
        b = {"type": rec["type"], "name": rec["fqdn"], "ttl": 1}
        if rec["type"] == "MX":
            prio, host = rec["value"].split()
            b.update(content=_norm_host(host), priority=int(prio))
        elif rec["type"] == "SRV":
            prio, weight, port, target = rec["value"].split()
            b["data"] = {"priority": int(prio), "weight": int(weight), "port": int(port),
                         "target": _norm_host(target)}
        elif rec["type"] == "TXT":
            b["content"] = rec["value"]
        else:
            b.update(content=_norm_host(rec["value"]), proxied=False)
        return b

    def create(self, zone, rec):
        _http("POST", f"{self.base}/zones/{zone}/dns_records", self.h, self._body(rec))

    def update(self, zone, rid, rec):
        _http("PUT", f"{self.base}/zones/{zone}/dns_records/{rid}", self.h, self._body(rec))

    def delete(self, zone, rid):
        _http("DELETE", f"{self.base}/zones/{zone}/dns_records/{rid}", self.h)


class DigitalOcean:
    name = "DigitalOcean"

    def __init__(self, token):
        self.base = os.environ.get("MAILCTL_DNS_API_URL", "https://api.digitalocean.com/v2")
        self.h = {"Authorization": f"Bearer {token}"}

    def zone(self, domain):
        parts = domain.split(".")
        for i in range(len(parts) - 1):
            z = ".".join(parts[i:])
            try:
                _http("GET", f"{self.base}/domains/{z}", self.h)
                return z, z
            except DnsApiError as e:
                if "(404)" not in str(e):
                    raise
        raise DnsApiError(f"{domain} is not in this DigitalOcean account")

    def _rel(self, zone, fqdn):
        return "@" if fqdn == zone else fqdn[:-(len(zone) + 1)]

    def list(self, zone, fqdn, rtype):
        r = _http("GET", f"{self.base}/domains/{zone}/records?type={rtype}&name={fqdn}&per_page=200", self.h)
        out = []
        for x in r.get("domain_records", []):
            name = zone if x["name"] == "@" else f"{x['name']}.{zone}"
            rec = {"id": x["id"], "type": x["type"], "fqdn": _norm_host(name)}
            if x["type"] == "MX":
                rec["value"] = f"{x.get('priority')} {_norm_host(x['data'])}"
            elif x["type"] == "SRV":
                rec["value"] = f"{x.get('priority')} {x.get('weight')} {x.get('port')} {_norm_host(x['data'])}"
            elif x["type"] == "TXT":
                rec["value"] = _norm_txt(x["data"])
            else:
                rec["value"] = _norm_host(x["data"])
            out.append(rec)
        return out

    def _body(self, zone, rec):
        b = {"type": rec["type"], "name": self._rel(zone, rec["fqdn"]), "ttl": 1800}
        if rec["type"] == "MX":
            prio, host = rec["value"].split()
            b.update(data=_norm_host(host) + ".", priority=int(prio))
        elif rec["type"] == "SRV":
            prio, weight, port, target = rec["value"].split()
            b.update(data=_norm_host(target) + ".", priority=int(prio), weight=int(weight), port=int(port))
        elif rec["type"] == "CNAME":
            b["data"] = _norm_host(rec["value"]) + "."
        else:
            b["data"] = rec["value"]
        return b

    def create(self, zone, rec):
        _http("POST", f"{self.base}/domains/{zone}/records", self.h, self._body(zone, rec))

    def update(self, zone, rid, rec):
        _http("PUT", f"{self.base}/domains/{zone}/records/{rid}", self.h, self._body(zone, rec))

    def delete(self, zone, rid):
        _http("DELETE", f"{self.base}/domains/{zone}/records/{rid}", self.h)


DNS_PROVIDERS = {"cloudflare": Cloudflare, "digitalocean": DigitalOcean}


def dns_provider_status():
    cfg = read_json(DNS_API_FILE, {})
    return {"provider": cfg.get("provider", ""),
            "name": DNS_PROVIDERS[cfg["provider"]].name if cfg.get("provider") in DNS_PROVIDERS else "",
            "connected": bool(cfg.get("token"))}


def dns_provider_set(provider, off=False):
    if off:
        if os.path.exists(DNS_API_FILE):
            os.remove(DNS_API_FILE)
        audit("dns provider off")
        return dns_provider_status()
    provider = (provider or "").lower()
    if provider not in DNS_PROVIDERS:
        raise Fail(f"unsupported DNS provider '{provider}' (use: {', '.join(DNS_PROVIDERS)})")
    token = sys.stdin.readline().strip() if not sys.stdin.isatty() else getpass.getpass("API token: ").strip()
    if not re.fullmatch(r"[A-Za-z0-9_\-.]{20,300}", token):
        raise Fail("that does not look like an API token")
    api = DNS_PROVIDERS[provider](token)
    api.zone(C["DOMAIN"])  # proves the token works and can see the domain
    fd = os.open(DNS_API_FILE + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"provider": provider, "token": token}, f)
    os.replace(DNS_API_FILE + ".tmp", DNS_API_FILE)
    audit(f"dns provider {provider}")
    info(f"connected to {api.name}")
    return dns_provider_status()


def _desired_matches(want, have):
    """Existing records at the same name/type that 'want' should replace."""
    t = want["type"]
    if t == "TXT":
        prefix = want["value"].split(";")[0].split(" ")[0]
        return [h for h in have if h["value"].startswith(prefix)]
    return have


def dns_apply(domain=None, dry_run=True):
    """Create/update this server's DNS records through the provider's API."""
    domain = lower_domain(domain or C["DOMAIN"])
    cfg = read_json(DNS_API_FILE, {})
    if not cfg.get("token") or cfg.get("provider") not in DNS_PROVIDERS:
        raise Fail("no DNS provider connected (mailctl dns provider set cloudflare|digitalocean)")
    api = DNS_PROVIDERS[cfg["provider"]](cfg["token"])
    zone_id, zone = api.zone(domain)
    plan = []
    for rec in dns_records(domain):
        fqdn = _norm_host(rec["fqdn"])
        if not (fqdn == zone or fqdn.endswith("." + zone)):
            plan.append({"action": "skip", "type": rec["type"], "fqdn": fqdn, "value": rec["value"],
                         "note": f"not in the {zone} zone - create it at that domain's provider"})
            continue
        want = {"type": rec["type"], "fqdn": fqdn,
                "value": rec["value"] if rec["type"] == "TXT" else
                " ".join(_norm_host(x) if i == len(rec["value"].split()) - 1 else x
                         for i, x in enumerate(rec["value"].split()))}
        have = api.list(zone_id, fqdn, rec["type"])
        if rec["type"] == "CNAME":
            clash = api.list(zone_id, fqdn, "A") + api.list(zone_id, fqdn, "AAAA")
            if clash:
                plan.append({"action": "skip", "type": "CNAME", "fqdn": fqdn, "value": want["value"],
                             "note": "an A/AAAA record already uses this name - left alone"})
                continue
        match = _desired_matches(want, have)
        if any(h["value"] == want["value"] for h in match) and len(match) == 1:
            plan.append({"action": "keep", "type": want["type"], "fqdn": fqdn, "value": want["value"]})
            continue
        if match:
            plan.append({"action": "update", "type": want["type"], "fqdn": fqdn, "value": want["value"],
                         "old": match[0]["value"], "id": match[0]["id"]})
            for extra in match[1:]:
                plan.append({"action": "delete", "type": want["type"], "fqdn": fqdn,
                             "value": extra["value"], "id": extra["id"]})
        else:
            plan.append({"action": "create", "type": want["type"], "fqdn": fqdn, "value": want["value"]})
    if not dry_run:
        for p in plan:
            rec = {"type": p["type"], "fqdn": p["fqdn"], "value": p["value"]}
            if p["action"] == "create":
                api.create(zone_id, rec)
            elif p["action"] == "update":
                api.update(zone_id, p["id"], rec)
            elif p["action"] == "delete":
                api.delete(zone_id, p["id"])
        changed = sum(1 for p in plan if p["action"] in ("create", "update", "delete"))
        audit(f"dns apply {domain}: {changed} change(s) via {api.name}")
        info(f"{changed} DNS change(s) made at {api.name}")
    for p in plan:
        p.pop("id", None)
    return {"domain": domain, "zone": zone, "provider": api.name, "dry_run": dry_run, "plan": plan}


# ------------------------------------------------------------------ output

MARK = {"ok": "✓", "warn": "!", "error": "✗"}


def table(rows, cols):
    if not rows:
        print("(none)")
        return
    widths = [max(len(h), *(len(str(r[i])) for r in rows)) for i, h in enumerate(cols)]
    print("  ".join(h.upper().ljust(w) for h, w in zip(cols, widths)).rstrip())
    for r in rows:
        print("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


def print_dns(domain, recs):
    print(f"DNS records for {domain}")
    print('(create these at your DNS provider; "@" means the domain itself)\n')
    table([(r["type"], r["name"], f'"{r["value"]}"' if r["type"] == "TXT" else r["value"])
           for r in recs], ["type", "name", "value"])
    print()
    if domain == C["DOMAIN"]:
        print("Reverse DNS (set in your hosting provider's control panel, not at your DNS provider):")
        print(f"  PTR  {C['SERVER_IPV4']}  ->  {C['MAIL_HOSTNAME']}")
        if C.get("SERVER_IPV6"):
            print(f"  PTR  {C['SERVER_IPV6']}  ->  {C['MAIL_HOSTNAME']}")
        print()
    print("The DKIM value is long. If your DNS provider rejects it, split it into")
    print("several quoted strings of up to 255 characters; most providers do this for you.")


def show_status(s):
    print("Services")
    for k, v in s["services"].items():
        print(f"  {k:<26} {v}")
    print("\nCertificate")
    c = s["certificate"]
    if c:
        print(f"  names   {', '.join(c['names'])}")
        print(f"  expires {c['expires'][:10]} ({c['days_left']} days)")
    else:
        print("  not found")
    n = s["counts"]
    print("\nMail")
    print(f"  domains:   {n['domains']}")
    print(f"  mailboxes: {n['mailboxes']}")
    print(f"  aliases:   {n['aliases']}")
    print(f"  queue:     {n['queue']} message(s) waiting")
    print(f"  disk:      {human_bytes(s['disk']['vmail'])} in {VMAIL_DIR}, "
          f"{human_bytes(s['disk']['free'])} free")


def show_rules(r):
    f, v = r.get("forward"), r.get("vacation")
    print(f"forwarding: {', '.join(f['to']) + (' (keeping a copy)' if f['keep'] else ' (no copy kept)') if f else 'off'}")
    if v:
        when = f"{v['start'] or 'now'} to {v['end'] or 'until switched off'}"
        print(f"vacation:   on, {when}: {v['subject']}")
    else:
        print("vacation:   off")


def show_apppw(r):
    print(f"{r['email']}: mail apps " + ("must use app passwords" if r["required"]
                                         else "may use the mailbox password or an app password"))
    table([(p["id"], p["name"], p["created"][:16].replace("T", " ")) for p in r["passwords"]],
          ["id", "name", "created"])


def show_import(r):
    if r["status"] == "none":
        print(f"no import for {r['email']}")
        return
    print(f"{r['email']}: {r['status']} - from {r['user']} at {r['host']}:{r['port']}, "
          f"started {r['started'][:16].replace('T', ' ')}"
          + (f", finished {r['finished'][:16].replace('T', ' ')}" if r.get("finished") else ""))
    if r.get("imported") is not None:
        print(f"messages imported: {r['imported']}")
    if r.get("message"):
        print(r["message"])
    if r["status"] == "running" and r.get("log"):
        print("\n".join(r["log"][-5:]))


def show_checks(rows):
    group = None
    for r in rows:
        if r["group"] != group:
            group = r["group"]
            print(f"\n{group}")
        print(f"  {MARK[r['status']]} {r['name']:<34} {r['detail']}")
    bad = sum(1 for r in rows if r["status"] == "error")
    warn = sum(1 for r in rows if r["status"] == "warn")
    print(f"\n{bad} problem(s), {warn} warning(s)")


USAGE = """Usage: mailctl [--json] <command> [arguments]

